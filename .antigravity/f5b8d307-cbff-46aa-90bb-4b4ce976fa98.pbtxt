fecha_inasistencia: string;\n  turno_recupero_id: string;\n  fecha_recupero: string;\n  estado: \'PENDIENTE\' | \'COMPLETADO\' | \'EXPIRADO\';\n}\n\nexport interface AuditLog {\n  id: string;\n  usuario_id: string;\n  usuario_email: string;\n  accion: string;\n  detalles: any;\n  creado_at: string;\n}\n"
