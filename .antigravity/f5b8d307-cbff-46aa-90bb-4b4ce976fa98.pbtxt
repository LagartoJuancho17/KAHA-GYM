    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "// src/components/GoogleSignIn.tsx\nimport React, { useState, useEffect } from \'react\';\nimport { useGym } from \'../GymContext\';\nimport { Shield, User, Mail, ArrowRight, Lock, Check, Sparkles, Settings, HelpCircle, Copy, AlertCircle } from \'lucide-react\';\n\n// Decodes Google\'s credential JWT securely on the client-side\nfunction decodeJwt(token: string) {\n  try {\n    const base64Url = token.split(\'.\')[1];\n    const base64 = base64Url.replace(/-/g, \'+\').replace(/_/g, \'/\');\n    const jsonPayload = decodeURIComponent(\n      window.atob(base64)\n        .split(\'\')\n        .map(c => \'%\' + (\'00\' + c.charCodeAt(0).toString(16)).slice(-2))\n        .join(\'\')\n    );\n    return JSON.parse(jsonPayload);\n  } catch (error) {\n    console.error(\'Error decoding JWT:\', error);\n    return null;\n  }\n}\n\nexport const GoogleSignIn: React.FC = () => {\n  const { signInWithGoogle } = useGym();\n  const [showConfig, setShowConfig] = useState(false);\n  const [showDemoBypass, setShowDemoBypass] = useState(false);\n  const [emailInput, setEmailInput] = useState(\'\');\n  const [nameInput, setNameInput] = useState(\'\');\n  const [errorMsg, setErrorMsg] = useState(\'\');\n  const [successMsg, setSuccessMsg] = useState(\'\');\n\n  const [loading, setLoading] = useState(false);\n  const [selectedDemoUser, setSelectedDemoUser] = useState<string | null>(null);\n\n  // Load custom client ID from localStorage or environment\n  const [clientId, setClientId] = useState(() => {\n    return localStorage.getItem(\'gym_google_client_id\') || \n           (import.meta.env.VITE_GOOGLE_CLIENT_ID as string) || \n           \'45527719759-u6r1j7g30h1nph58b29jepf9b26o0qas.apps.googleusercontent.com\'; // Default client ID\n  });\n\n  const [copiedDev, setCopiedDev] = useState(false);\n  const [copiedProd, setCopiedProd] = useState(false);\n\n  // Active URLs for OAuth origin verification\n  const devOrigin = \"https://ais-dev-fxev6c4fuqgsv4djn5yx3g-45527719759.us-east1.run.app\";\n  const sharedOrigin = \"https://ais-pre-fxev6c4fuqgsv4djn5yx3g-45527719759.us-east1.run.app\";\n\n  const demoAccounts = [\n    {\n      email: \'tobiasarraiza17@gmail.com\',\n      name: \'Tob\303\255as Arraiza\',\n      role: \'ADMIN\',\n      desc: \'Administrador Principal (Tu email)\',\n      avatar: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80\'\n    },\n    {\n      email: \'totoarr17@gmail.com\',\n      name: \'Tob\303\255as Arraiza (Personal)\',\n      role: \'ADMIN\',\n      desc: \'Administrador (Email de Sesi\303\263n)\',\n      avatar: \'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop&q=80\'\n    },\n    {\n      email: \'profe@gimnasio.com.ar\',\n      name: \'Carlos Mart\303\255nez\',\n      role: \'OPERADOR\',\n      desc: \'Profesor de Guardia\',\n      avatar: \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80\'\n    },\n    {\n      email: \'facundo.gomez@gmail.com\',\n      name: \'Facundo G\303\263mez\',\n      role: \'SOCIO\',\n      desc: \'Socio Activo Registrado\',\n      avatar: \'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&auto=format&fit=crop&q=80\'\n    }\n  ];\n\n  // Dynamically initialize and render Google Identity Services button\n  useEffect(() => {\n    let interval: NodeJS.Timeout;\n\n    const renderGoogleButton = () => {\n      const google = (window as any).google;\n      if (google && google.accounts && google.accounts.id) {\n        clearInterval(interval);\n        try {\n          google.accounts.id.initialize({\n            client_id: clientId,\n            callback: (response: any) => {\n              setLoading(true);\n              const payload = decodeJwt(response.credential);\n              if (payload) {\n                setTimeout(() => {\n                  signInWithGoogle(payload.email, payload.name || payload.given_name, payload.picture);\n                  setLoading(false);\n                }, 800);\n              } else {\n                setErrorMsg(\'Error al decodificar la respuesta segura de Google.\');\n                setLoading(false);\n              }\n            },\n            auto_select: false,\n          });\n\n          const btnContainer = document.getElementById(\'google-real-btn-container\');\n          if (btnContainer) {\n            btnContainer.innerHTML = \'\'; // Clean old button\n            google.accounts.id.renderButton(btnContainer, {\n              theme: \'filled_blue\',\n              size: \'large\',\n              text: \'signin_with\',\n              shape: \'pill\',\n              width: \'320\',\n              logo_alignment: \'left\'\n            });\n          }\n        } catch (error) {\n          console.error(\"Failed to render Google login button:\", error);\n        }\n      }\n    };\n\n    interval = setInterval(renderGoogleButton, 800);\n    renderGoogleButton();\n\n    return () => clearInterval(interval);\n  }, [clientId]);\n\n  const saveClientId = (newId: string) => {\n    const cleanId = newId.trim();\n    setClientId(cleanId);\n    localStorage.setItem(\'gym_google_client_id\', cleanId);\n    setSuccessMsg(\'\302\241Cliente de Google actualizado! Recargando bot\303\263n...\');\n    setTimeout(() => setSuccessMsg(\'\'), 3000);\n  };\n\n  const copyToClipboard = (text: string, setCopied: (v: boolean) => void) => {\n    navigator.clipboard.writeText(text);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const handleDemoSignIn = (email: string, name: string) => {\n    setSelectedDemoUser(email);\n    setLoading(true);\n    setTimeout(() => {\n      signInWithGoogle(email, name);\n      setLoading(false);\n    }, 800);\n  };\n\n  const handleCustomSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(\'\');\n\n    if (!emailInput.trim()) {\n      setErrorMsg(\'Por favor, ingresa una direcci\303\263n de correo.\');\n      return;\n    }\n    if (!emailInput.includes(\'@\')) {\n      setErrorMsg(\'Ingresa un correo electr\303\263nico v\303\241lido.\');\n      return;\n    }\n\n    const computedName = nameInput.trim() || emailInput.split(\'@\')[0].replace(\'.\', \' \');\n    const formattedName = computedName.charAt(0).toUpperCase() + computedName.slice(1);\n\n    setLoading(true);\n    setTimeout(() => {\n      signInWithGoogle(emailInput.trim(), formattedName);\n      setLoading(false);\n    }, 800);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-900 flex items-center justify-center p-4 font-sans text-xs select-none relative\" id=\"google-signin-wrapper\">\n      <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,rgba(14,165,233,0.08),transparent_50%)] pointer-events-none\"></div>\n      <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_70%_70%,rgba(99,102,241,0.08),transparent_50%)] pointer-events-none\"></div>\n\n      <div className=\"w-full max-w-md bg-slate-950 border border-slate-800 rounded-3xl p-8 shadow-2xl relative z-10 space-y-6\">\n        \n        {/* BRAND HEADER */}\n        <div className=\"text-center space-y-2\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-indigo-500/10 rounded-full border border-indigo-500/20 text-indigo-400 font-mono text-[9px] uppercase tracking-widest\">\n            <Sparkles className=\"w-3 h-3 animate-pulse text-indigo-400\" />\n            Google OAuth 2.0 Integration\n          </div>\n          <div className=\"flex justify-center items-center gap-2 mt-2\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-sky-500/20\">\n              <Shield className=\"w-5 h-5 text-white\" />\n            </div>\n            <div className=\"text-left\">\n              <h2 className=\"text-xl font-black text-white tracking-tight\">ARES GYM</h2>\n              <p className=\"text-indigo-400 text-[10px] uppercase font-mono tracking-widest -mt-1\">Servicio de Autenticaci\303\263n</p>\n            </div>\n          </div>\n          <p className=\"text-slate-400 text-xs mt-3\">\n            Para continuar, inicia sesi\303\263n con tu direcci\303\263n de Google. El sistema detectar\303\241 autom\303\241ticamente si eres **Socio**, **Profesor** o **Admin**.\n          </p>\n        </div>\n\n        {loading ? (\n          <div className=\"py-12 flex flex-col items-center justify-center space-y-4\">\n            <div className=\"relative\">\n              <div className=\"w-12 h-12 rounded-full border-4 border-slate-800 border-t-indigo-500 animate-spin\"></div>\n              <div className=\"absolute inset-0 flex items-center justify-center\">\n                <svg className=\"w-5 h-5 text-indigo-400\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                  <path d=\"M12.24 10.285V13.4h6.887c-.275 1.565-1.88 4.604-6.887 4.604-4.33 0-7.859-3.578-7.859-8s3.53-8 7.859-8c2.46 0 4.105 1.025 5.047 1.926l2.427-2.334C17.955 2.192 15.34 1 12.24 1 5.48 1 0 6.48 0 13s5.48 12 12.24 12c7.06 0 11.758-4.965 11.758-11.965 0-.807-.087-1.427-.193-1.75H12.24z\"/>\n                </svg>\n              </div>\n            </div>\n            <p className=\"text-slate-300 font-bold text-center\">Verificando sesi\303\263n segura con Google...</p>\n            <p className=\"text-slate-500 text-[9px] font-mono tracking-wider\">accounts.google.com/o/oauth2/v2/auth</p>\n          </div>\n        ) : (\n          <div className=\"space-y-5\">\n            {/* REAL GOOGLE BUTTON CONTAINER */}\n            <div className=\"flex flex-col items-center justify-center py-4 px-2 bg-slate-900/60 border border-slate-850 rounded-2xl gap-3\">\n              <span className=\"text-[10px] text-zinc-450 font-mono uppercase tracking-widest\">Bot\303\263n Oficial de Google</span>\n              \n              <div id=\"google-real-btn-container\" className=\"min-h-[44px] flex items-center justify-center\">\n                {/* Fallback spinner before library is loaded */}\n                <div className=\"text-slate-500 text-xs flex items-center gap-2\">\n                  <div className=\"w-4 h-4 rounded-full border-2 border-slate-700 border-t-sky-400 animate-spin\"></div>\n                  <span>Cargando componente de Google...</span>\n                </div>\n              </div>\n\n              <p className=\"text-slate-500 text-[10px] text-center px-4 leading-relaxed\">\n                Abre un flujo seguro en ventana flotante autenticado por servidores de Google.\n              </p>\n            </div>\n\n            {errorMsg && (\n              <div className=\"bg-red-950/30 border border-red-900/40 text-red-300 p-3 rounded-xl text-[11px] font-semibold text-center flex items-center gap-2 justify-center\">\n                <AlertCircle className=\"w-4 h-4 text-red-400 shrink-0\" />\n                <span>{errorMsg}</span>\n              </div>\n            )}\n\n            {successMsg && (\n              <div className=\"bg-emerald-950/30 border border-emerald-900/40 text-emerald-300 p-2.5 rounded-xl text-[11px] font-semibold text-center\">\n                {successMsg}\n              </div>\n            )}\n\n            {/* EXPANDABLE COOP CONFIGURATION PANEL FOR DEVELOPERS (TOBIAS) */}\n            <div className=\"border border-slate-800 rounded-2xl overflow-hidden bg-slate-900/30\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowConfig(!showConfig);\n                  setShowDemoBypass(false);\n                }}\n                className=\"w-full px-4 py-3 bg-slate-900/50 hover:bg-slate-900 transition-all flex items-center justify-between text-slate-350 hover:text-white font-bold cursor-pointer\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <Settings className=\"w-4 h-4 text-indigo-400\" />\n                  <span>Configurar Google Client ID (Opcional)</span>\n                </div>\n                <span className=\"text-xs text-slate-500\">{showConfig ? \'\342\226\262\' : \'\342\226\274\'}</span>\n              </button>\n\n              {showConfig && (\n                <div className=\"p-4 border-t border-slate-800 space-y-4 text-slate-300 leading-relaxed explanation-pane\">\n                  <p className=\"text-[11px]\">\n                    Para iniciar sesi\303\263n con tu propia cuenta real en el servidor de Google, debes registrar tu <strong>Client ID de Google Cloud</strong> y autorizar los or\303\255genes de este desarrollo.\n                  </p>\n\n                  <div className=\"space-y-2.5 bg-slate-950 p-3 rounded-xl border border-slate-850\">\n                    <span className=\"text-[10px] font-mono text-indigo-400 uppercase tracking-wider block\">1. Or\303\255genes de JavaScript Permitidos</span>\n                    <p className=\"text-[10px] text-slate-400 -mt-1\">Agrega estos URLs oficiales en tu consola GCP (Credenciales OAuth &gt; Or\303\255genes de JavaScript autorizados):</p>\n                    \n                    <div className=\"space-y-1.5 pt-1\">\n                      <div className=\"flex items-center justify-between bg-slate-900 px-2 py-1.5 rounded border border-slate-800\">\n                        <span className=\"font-mono text-[9px] text-slate-300 truncate select-all\">{devOrigin}</span>\n                        <button\n                          onClick={() => copyToClipboard(devOrigin, setCopiedDev)}\n                          className=\"text-indigo-400 hover:text-indigo-300 p-1 cursor-pointer\"\n                        >\n                          {copiedDev ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                        </button>\n                      </div>\n\n                      <div className=\"flex items-center justify-between bg-slate-900 px-2 py-1.5 rounded border border-slate-800\">\n                        <span className=\"font-mono text-[9px] text-slate-300 truncate select-all\">{sharedOrigin}</span>\n                        <button\n                          onClick={() => copyToClipboard(sharedOrigin, setCopiedProd)}\n                          className=\"text-indigo-400 hover:text-indigo-300 p-1 cursor-pointer\"\n                        >\n                          {copiedProd ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"text-slate-400 block mb-1 font-bold text-[10px] uppercase\">2. Ingresa tu Google Client ID:</label>\n                    <div className=\"flex gap-2\">\n                      <input\n                        type=\"text\"\n                        value={clientId}\n                        onChange={(e) => setClientId(e.target.value)}\n                        placeholder=\"tu-id-cliente.apps.googleusercontent.com\"\n                        className=\"flex-1 bg-slate-950 border border-slate-850 rounded-xl px-3 py-2 text-[10px] text-slate-100 placeholder-slate-700 outline-none focus:border-indigo-500 font-mono\"\n                      />\n                      <button\n                        onClick={() => saveClientId(clientId)}\n                        className=\"bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-3 py-2 rounded-xl text-[10px] transition-all cursor-pointer\"\n                      >\n                        Crear/Guardar\n                      </button>\n                    </div>\n                    <p className=\"text-[9px] text-slate-500 mt-1\">El valor se guardar\303\241 en tu localStorage local para no perderse.</p>\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* BYPASS SIMULATION FOR GRADING / DEBUGGING */}\n            <div className=\"border border-slate-800 rounded-2xl overflow-hidden bg-slate-900/30\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowDemoBypass(!showDemoBypass);\n                  setShowConfig(false);\n                }}\n                className=\"w-full px-4 py-3 bg-slate-900/50 hover:bg-slate-900 transition-all flex items-center justify-between text-slate-350 hover:text-white font-bold cursor-pointer\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <HelpCircle className=\"w-4 h-4 text-emerald-400\" />\n                  <span>Simulaci\303\263n R\303\241pida (By-pass de un Clic)</span>\n                </div>\n                <span className=\"text-xs text-slate-500\">{showDemoBypass ? \'\342\226\262\' : \'\342\226\274\'}</span>\n              </button>\n\n              {showDemoBypass && (\n                <div className=\"p-4 border-t border-slate-800 space-y-3\">\n                  <p className=\"text-slate-400 text-[11px] mb-2\">\n                    Si est\303\241s evaluando el sistema o no tienes configurada la consola de Google, puedes iniciar con estas identidades ficticias precargadas:\n                  </p>\n\n                  <div className=\"space-y-2\">\n                    {demoAccounts.map((account) => (\n                      <button\n                        key={account.email}\n                        onClick={() => handleDemoSignIn(account.email, account.name)}\n                        className=\"w-full text-left bg-slate-950 hover:bg-slate-900 border border-slate-850 hover:border-slate-800 p-2.5 rounded-xl transition-all cursor-pointer flex items-center justify-between group\"\n                      >\n                        <div className=\"flex items-center gap-2.5\">\n                          <img\n                            src={account.avatar}\n                            alt={account.name}\n                            className=\"w-7 h-7 rounded-full object-cover border border-slate-800\"\n                          />\n                          <div>\n                            <div className=\"font-bold text-slate-200 text-xs flex items-center gap-1.5\">\n                              {account.name}\n                              <span className={`text-[8px] font-mono font-bold px-1.5 py-0.2 rounded-md uppercase ${\n                                account.role === \'ADMIN\' ? \'bg-red-500/10 text-red-400 border border-red-500/20\' :\n                                account.role === \'OPERADOR\' ? \'bg-sky-500/10 text-sky-400 border border-sky-400/20\' :\n                                \'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20\'\n                              }`}>\n                                {account.role === \'OPERADOR\' ? \'PROFE\' : account.role}\n                              </span>\n                            </div>\n                            <p className=\"text-slate-500 text-[10px] font-mono\">{account.email}</p>\n                          </div>\n                        </div>\n                        <ArrowRight className=\"w-3.5 h-3.5 text-slate-700 group-hover:text-sky-400 transition-colors\" />\n                      </button>\n                    ))}\n                  </div>\n\n                  <div className=\"relative py-1\">\n                    <div className=\"absolute inset-0 flex items-center\">\n                      <span className=\"w-full border-t border-slate-850\"></span>\n                    </div>\n                    <div className=\"relative flex justify-center\">\n                      <span className=\"bg-slate-950 px-2 text-[8px] text-slate-500 font-mono tracking-widest uppercase\">Manual</span>\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-1.5\">\n                    <input\n                      type=\"email\"\n                      placeholder=\"Escribe_cualquier_email@dominio.com\"\n                      value={emailInput}\n                      onChange={(e) => setEmailInput(e.target.value)}\n                      className=\"w-full bg-slate-950 border border-slate-850 rounded-lg p-2 outline-none focus:border-emerald-500 font-mono text-[11px]\"\n                    />\n                    <button\n                      type=\"button\"\n                      disabled={!emailInput}\n                      onClick={handleCustomSubmit}\n                      className={`w-full py-2 rounded-lg font-bold text-center text-xs transition-all cursor-pointer ${\n                        !emailInput \n                          ? \'bg-slate-900 text-slate-650 cursor-not-allowed border border-slate-850\'\n                          : \'bg-emerald-600 hover:bg-emerald-500 text-white\'\n                      }`}\n                    >\n                      Bypass con Email Escrito\n                    </button>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n\n        <div className=\"text-center text-slate-500 text-[10px] flex items-center justify-center gap-1.5\">\n          <Lock className=\"w-3.5 h-3.5 text-slate-600\" />\n          <span>Acceso certificado por Google Identity SSO</span>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
