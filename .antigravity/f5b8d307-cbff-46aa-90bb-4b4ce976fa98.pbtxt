    instruction: "Implement sidebar grid layout, responsive navigation, ticking date-time clock, and elegant operator bio tags"
    replacement_infos {
      original_chunk {
        target_content: "// src/App.tsx\nimport { useState } from \'react\';\nimport { GymProvider } from \'./GymContext\';\nimport { RoleSwitcher } from \'./components/RoleSwitcher\';\nimport { Dashboard } from \'./components/Dashboard\';\nimport { ClientesCRUD } from \'./components/ClientesCRUD\';\nimport { PlanesPricing } from \'./components/PlanesPricing\';\nimport { TurnosGrid } from \'./components/TurnosGrid\';\nimport { PagosLog } from \'./components/PagosLog\';\nimport { MorososControl } from \'./components/MorososControl\';\nimport { ProyeccionesTab } from \'./components/ProyeccionesTab\';\nimport { AuditLogView } from \'./components/AuditLogView\';\n\nimport { \n  Dribbble, Landmark, LayoutDashboard, Users, CreditCard, \n  CalendarRange, ShieldAlert, LineChart, ShieldCheck \n} from \'lucide-react\';\n\ntype TabID = \'DASHBOARD\' | \'CLIENTES\' | \'PLANES\' | \'TURNOS\' | \'PAGOS\' | \'MOROSIDAD\' | \'PROYECCIONES\' | \'AUDITORIA\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<TabID>(\'DASHBOARD\');\n  const [showAddPagoModal, setShowAddPagoModal] = useState(false);\n\n  const TAB_ITEMS = [\n    { id: \'DASHBOARD\' as TabID, label: \'Resumen\', icon: LayoutDashboard },\n    { id: \'CLIENTES\' as TabID, label: \'Socios\', icon: Users },\n    { id: \'PLANES\' as TabID, label: \'Planes\', icon: Dribbble },\n    { id: \'TURNOS\' as TabID, label: \'Cupos y Turnos\', icon: CalendarRange },\n    { id: \'PAGOS\' as TabID, label: \'Pagos e Ingresos\', icon: Landmark },\n    { id: \'MOROSIDAD\' as TabID, label: \'Control de Mora\', icon: ShieldAlert },\n    { id: \'PROYECCIONES\' as TabID, label: \'Previsiones\', icon: LineChart },\n    { id: \'AUDITORIA\' as TabID, label: \'Auditor\303\255a DB\', icon: ShieldCheck },\n  ];\n\n  const renderActiveTabContent = () => {\n    switch (activeTab) {\n      case \'DASHBOARD\':\n        return <Dashboard setActiveTab={(tab) => setActiveTab(tab as TabID)} />;\n      case \'CLIENTES\':\n        return <ClientesCRUD />;\n      case \'PLANES\':\n        return <PlanesPricing />;\n      case \'TURNOS\':\n        return <TurnosGrid />;\n      case \'PAGOS\':\n        return (\n          <PagosLog \n            showAddPagoModal={showAddPagoModal} \n            setShowAddPagoModal={setShowAddPagoModal} \n          />\n        );\n      case \'MOROSIDAD\':\n        return <MorososControl />;\n      case \'PROYECCIONES\':\n        return <ProyeccionesTab />;\n      case \'AUDITORIA\':\n        return <AuditLogView />;\n      default:\n        return <Dashboard setActiveTab={(tab) => setActiveTab(tab as TabID)} />;\n    }\n  };\n\n  return (\n    <GymProvider>\n      <div className=\"min-h-screen bg-[#fafafb] flex flex-col text-zinc-900 font-sans\" id=\"app-wrapper\">\n        {/* Floating Top Header: Branding + DB switcher */}\n        <RoleSwitcher />\n\n        {/* Tab Selection Header */}\n        <div className=\"bg-white border-b border-zinc-200 sticky top-0 z-40 shadow-xs\" id=\"navigation-tabs-bar\">\n          <div className=\"max-w-7xl mx-auto px-4 overflow-x-auto flex gap-1\">\n            {TAB_ITEMS.map(item => {\n              const Icon = item.icon;\n              const isSelected = activeTab === item.id;\n              \n              return (\n                <button\n                  key={item.id}\n                  onClick={() => setActiveTab(item.id)}\n                  className={`flex items-center gap-2 px-4 py-3.5 border-b-2 text-xs font-sans font-bold transition-all whitespace-nowrap outline-hidden ${\n                    isSelected \n                      ? \'border-black text-black bg-zinc-50/50\' \n                      : \'border-transparent text-zinc-500 hover:text-zinc-900 hover:border-zinc-300\'\n                  }`}\n                  id={`tab-btn-${item.id.toLowerCase()}`}\n                >\n                  <Icon className={`w-4 h-4 ${isSelected ? \'text-black\' : \'text-zinc-400\'}`} />\n                  {item.label}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Main View Area */}\n        <main className=\"flex-1 pb-16\">\n          {renderActiveTabContent()}\n        </main>\n      </div>\n    </GymProvider>\n  );\n}"
        replacement_content: "// src/App.tsx\nimport { useState, useEffect } from \'react\';\nimport { GymProvider, useGym } from \'./GymContext\';\nimport { RoleSwitcher } from \'./components/RoleSwitcher\';\nimport { Dashboard } from \'./components/Dashboard\';\nimport { ClientesCRUD } from \'./components/ClientesCRUD\';\nimport { PlanesPricing } from \'./components/PlanesPricing\';\nimport { TurnosGrid } from \'./components/TurnosGrid\';\nimport { PagosLog } from \'./components/PagosLog\';\nimport { MorososControl } from \'./components/MorososControl\';\nimport { ProyeccionesTab } from \'./components/ProyeccionesTab\';\nimport { AuditLogView } from \'./components/AuditLogView\';\n\nimport { \n  Dribbble, Landmark, LayoutDashboard, Users, CreditCard, \n  CalendarRange, ShieldAlert, LineChart, ShieldCheck,\n  Menu, X, MapPin, Shield\n} from \'lucide-react\';\n\ntype TabID = \'DASHBOARD\' | \'CLIENTES\' | \'PLANES\' | \'TURNOS\' | \'PAGOS\' | \'MOROSIDAD\' | \'PROYECCIONES\' | \'AUDITORIA\';\n\nexport default function App() {\n  return (\n    <GymProvider>\n      <InnerApp />\n    </GymProvider>\n  );\n}\n\nfunction InnerApp() {\n  const [activeTab, setActiveTab] = useState<TabID>(\'DASHBOARD\');\n  const [showAddPagoModal, setShowAddPagoModal] = useState(false);\n  const [isSidebarOpen, setIsSidebarOpen] = useState(false);\n  const { rolActivo } = useGym();\n\n  const [timeString, setTimeString] = useState(\'\');\n  const [dateString, setDateString] = useState(\'\');\n\n  useEffect(() => {\n    const updateTime = () => {\n      const now = new Date();\n      \n      const optionsTime: Intl.DateTimeFormatOptions = { \n        hour: \'2-digit\', \n        minute: \'2-digit\',\n        second: \'2-digit\',\n        hour12: false \n      };\n      \n      try {\n        setTimeString(now.toLocaleTimeString(\'es-AR\', {\n          timeZone: \'America/Argentina/Buenos_Aires\',\n          hour: \'2-digit\',\n          minute: \'2-digit\',\n          second: \'2-digit\',\n          hour12: false\n        }));\n        \n        const rawDate = now.toLocaleDateString(\'es-AR\', {\n          timeZone: \'America/Argentina/Buenos_Aires\',\n          day: \'2-digit\',\n          month: \'short\',\n          year: \'numeric\'\n        });\n        setDateString(`Buenos Aires, AR | ${rawDate}`);\n      } catch (e) {\n        setTimeString(now.toLocaleTimeString());\n        setDateString(now.toLocaleDateString());\n      }\n    };\n    \n    updateTime();\n    const timer = setInterval(updateTime, 1000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const TAB_ITEMS = [\n    { id: \'DASHBOARD\' as TabID, label: \'Dashboard\', icon: LayoutDashboard, desc: \'Panel de Control General\' },\n    { id: \'CLIENTES\' as TabID, label: \'Socios\', icon: Users, desc: \'Gesti\303\263n Integral de Socios\' },\n    { id: \'PLANES\' as TabID, label: \'Planes\', icon: Dribbble, desc: \'Control de Membres\303\255as y Planes\' },\n    { id: \'TURNOS\' as TabID, label: \'Cupos y Turnos\', icon: CalendarRange, desc: \'Grilla de Horarios y Reservas\' },\n    { id: \'PAGOS\' as TabID, label: \'Pagos e Ingresos\', icon: Landmark, desc: \'Libro Contable y Facturaci\303\263n\' },\n    { id: \'MOROSIDAD\' as TabID, label: \'Control de Mora\', icon: ShieldAlert, desc: \'Seguimiento de Deudas\' },\n    { id: \'PROYECCIONES\' as TabID, label: \'Previsiones\', icon: LineChart, desc: \'Proyecciones Financieras\' },\n    { id: \'AUDITORIA\' as TabID, label: \'Auditor\303\255a DB\', icon: ShieldCheck, desc: \'Registro de Operaciones de Base\' },\n  ];\n\n  const currentTab = TAB_ITEMS.find(t => t.id === activeTab) || TAB_ITEMS[0];\n\n  const renderActiveTabContent = () => {\n    switch (activeTab) {\n      case \'DASHBOARD\':\n        return <Dashboard setActiveTab={(tab) => setActiveTab(tab as TabID)} />;\n      case \'CLIENTES\':\n        return <ClientesCRUD />;\n      case \'PLANES\':\n        return <PlanesPricing />;\n      case \'TURNOS\':\n        return <TurnosGrid />;\n      case \'PAGOS\':\n        return (\n          <PagosLog \n            showAddPagoModal={showAddPagoModal} \n            setShowAddPagoModal={setShowAddPagoModal} \n          />\n        );\n      case \'MOROSIDAD\':\n        return <MorososControl />;\n      case \'PROYECCIONES\':\n        return <ProyeccionesTab />;\n      case \'AUDITORIA\':\n        return <AuditLogView />;\n      default:\n        return <Dashboard setActiveTab={(tab) => setActiveTab(tab as TabID)} />;\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col lg:flex-row text-slate-900 font-sans antialiased\" id=\"app-wrapper\">\n      \n      {/* MOBILE HEADER BAR */}\n      <div className=\"lg:hidden bg-slate-950 text-slate-100 px-4 py-3 flex items-center justify-between border-b border-slate-900 z-50 sticky top-0 shadow-md\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-8 h-8 rounded-lg bg-sky-500/10 flex items-center justify-center border border-sky-400/20\">\n            <Shield className=\"w-4.5 h-4.5 text-sky-400\" />\n          </div>\n          <h1 className=\"text-white font-extrabold tracking-tight text-sm\">\n            ARES GYM <span className=\"text-[10px] text-sky-400 font-semibold block -mt-1\">Administraci\303\263n</span>\n          </h1>\n        </div>\n        \n        <button \n          onClick={() => setIsSidebarOpen(!isSidebarOpen)}\n          className=\"p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-colors\"\n          aria-label=\"Toggle navigation drawer\"\n        >\n          {isSidebarOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n        </button>\n      </div>\n\n      {/* LEFT NAVIGATION SIDEBAR (GEOMETRIC SLATE-900 BACKGROUND) */}\n      <aside className={`\n        fixed inset-y-0 left-0 z-40 w-[260px] bg-slate-950 text-slate-400 p-6 flex flex-col justify-between border-r border-slate-900 transition-transform duration-300 transform\n        lg:translate-x-0 lg:static lg:h-screen lg:overflow-y-auto\n        ${isSidebarOpen ? \'translate-x-0\' : \'-translate-x-full lg:translate-x-0\'}\n      `} id=\"app-sidebar-nav\">\n        \n        <div className=\"flex flex-col gap-6\">\n          {/* Logo / Brand block matching the exact style of APOLO GYM */}\n          <div className=\"mb-2 hidden lg:block\">\n            <h1 className=\"text-slate-50 text-xl font-extrabold tracking-tight\" id=\"sidebar-logo-heading\">\n              ARES GYM \n              <span className=\"text-[#38bdf8] text-xs font-semibold tracking-wider block uppercase mt-0.5\" id=\"sidebar-logo-subtitle\">\n                Administraci\303\263n\n              </span>\n            </h1>\n          </div>\n\n          {/* Nav List */}\n          <nav className=\"flex flex-col gap-1\" id=\"sidebar-navigation-items\">\n            {TAB_ITEMS.map(item => {\n              const Icon = item.icon;\n              const isSelected = activeTab === item.id;\n              \n              return (\n                <button\n                  key={item.id}\n                  onClick={() => {\n                    setActiveTab(item.id);\n                    setIsSidebarOpen(false);\n                  }}\n                  className={`\n                    w-full px-4 py-3 rounded-lg flex items-center gap-3 text-xs font-semibold transition-all duration-150 outline-hidden cursor-pointer\n                    ${isSelected \n                      ? \'bg-slate-800 text-slate-50 border border-slate-700/50 shadow-sm\' \n                      : \'text-slate-400 hover:text-slate-200 hover:bg-slate-900/50 border border-transparent\'\n                    }\n                  `}\n                  id={`tab-btn-sidebar-${item.id.toLowerCase()}`}\n                >\n                  <Icon className={`w-4 h-4 transition-colors ${isSelected ? \'text-sky-400\' : \'text-slate-500\'}`} />\n                  <span>{item.label}</span>\n                </button>\n              );\n            })}\n          </nav>\n        </div>\n\n        {/* LOGGED CONTEXT CARD (Matching Juan Rodr\303\255guez style) */}\n        <div className=\"pt-4 border-t border-slate-900 mt-6\" id=\"sidebar-user-context-card\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-9 h-9 rounded-full bg-sky-450 text-slate-950 font-extrabold text-sm flex items-center justify-center shadow-lg shadow-sky-500/10\">\n              {rolActivo === \'ADMIN\' ? \'AR\' : \'OP\'}\n            </div>\n            <div className=\"min-w-0 flex-1\">\n              <p className=\"text-[11px] font-bold text-slate-200 truncate leading-tight\">\n                {rolActivo === \'ADMIN\' ? \'Admin Principal\' : \'Operativo Guardia\'}\n              </p>\n              <p className=\"text-[9px] text-slate-500 font-medium truncate mt-0.5\">\n                {rolActivo === \'ADMIN\' ? \'Administrador Senior\' : \'Operador Limitado\'}\n              </p>\n            </div>\n            <div className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\" title=\"Sesi\303\263n activa local\"></div>\n          </div>\n        </div>\n      </aside>\n\n      {/* BACKDROP FOR MOBILE DRAWER */}\n      {isSidebarOpen && (\n        <div \n          onClick={() => setIsSidebarOpen(false)}\n          className=\"fixed inset-0 bg-slate-950/40 backdrop-blur-xs z-35 lg:hidden animate-fade-in\"\n        ></div>\n      )}\n\n      {/* RIGHT SIDE MAIN CONTAINER */}\n      <div className=\"flex-1 flex flex-col min-w-0 min-h-screen\" id=\"main-content-flow\">\n        \n        {/* Floating Top Header: DB switcher & Roles */}\n        <RoleSwitcher />\n\n        {/* GEOMETRIC THEMED SUB-HEADER (Matching the clean header element) */}\n        <header className=\"bg-white border-b border-slate-200 px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 shadow-xs\" id=\"sub-header-container\">\n          <div>\n            <span className=\"text-[10px] text-slate-400 font-bold uppercase tracking-widest block mb-0.5 font-mono\">\n              Entorno Seguro\n            </span>\n            <span className=\"text-base font-bold text-slate-800 flex items-center gap-2 tracking-tight\" id=\"current-tab-label-header\">\n              {currentTab.desc}\n            </span>\n          </div>\n          \n          <div className=\"sm:text-right flex sm:flex-col justify-between sm:justify-start items-center sm:items-end gap-1 font-sans\">\n            <p className=\"text-xs text-slate-400 font-semibold flex items-center gap-1\">\n              <MapPin className=\"w-3.5 h-3.5 text-slate-300\" />\n              <span>{dateString || \'Buenos Aires, AR\'}</span>\n            </p>\n            <p className=\"text-sm font-bold text-slate-900 font-mono tracking-tight bg-slate-100/50 px-2.5 py-0.5 rounded-md border border-slate-200/40\">\n              {timeString || \'00:00:00\'}\n            </p>\n          </div>\n        </header>\n\n        {/* Main View Area */}\n        <main className=\"flex-1 p-6 overflow-y-auto\">\n          {renderActiveTabContent()}\n        </main>\n      </div>\n\n    </div>\n  );\n}\n"
      }
      num_matches: 1
    }
  }
}
