      replacement_content: "// src/components/GoogleSignIn.tsx\nimport React, { useState } from \'react\';\nimport { useGym } from \'../GymContext\';\nimport { Shield, User, Landmark, Mail, ArrowRight, Lock, Check, Sparkles } from \'lucide-react\';\n\nexport const GoogleSignIn: React.FC = () => {\n  const { signInWithGoogle } = useGym();\n  const [useCustom, setUseCustom] = useState(false);\n  const [emailInput, setEmailInput] = useState(\'\');\n  const [nameInput, setNameInput] = useState(\'\');\n  const [errorMsg, setErrorMsg] = useState(\'\');\n\n  const [loading, setLoading] = useState(false);\n  const [selectedDemoUser, setSelectedDemoUser] = useState<string | null>(null);\n\n  const demoAccounts = [\n    {\n      email: \'tobiasarraiza17@gmail.com\',\n      name: \'Tob\303\255as Arraiza\',\n      role: \'ADMIN\',\n      desc: \'Administrador General (Email oficial)\',\n      avatar: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80\',\n      color: \'border-red-500 text-red-600 bg-red-50\'\n    },\n    {\n      email: \'profe@gimnasio.com.ar\',\n      name: \'Carlos Mart\303\255nez\',\n      role: \'OPERADOR\',\n      desc: \'Profesor / Operador T\303\251cnico\',\n      avatar: \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80\',\n      color: \'border-sky-500 text-sky-600 bg-sky-50\'\n    },\n    {\n      email: \'facundo.gomez@gmail.com\',\n      name: \'Facundo G\303\263mez\',\n      role: \'SOCIO\',\n      desc: \'Socio Activo (Plan 3 D\303\255as/Semana)\',\n      avatar: \'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&auto=format&fit=crop&q=80\',\n      color: \'border-indigo-500 text-indigo-600 bg-indigo-50\'\n    },\n    {\n      email: \'sofia.rod@hotmail.com\',\n      name: \'Sof\303\255a Rodr\303\255guez\',\n      role: \'SOCIO\',\n      desc: \'Socio con Perfil Moroso (Plan 2 D\303\255as)\',\n      avatar: \'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=80\',\n      color: \'border-amber-500 text-amber-600 bg-amber-50\'\n    }\n  ];\n\n  const handleDemoSignIn = (email: string, name: string) => {\n    setSelectedDemoUser(email);\n    setLoading(true);\n    setTimeout(() => {\n      signInWithGoogle(email, name);\n      setLoading(false);\n    }, 850);\n  };\n\n  const handleCustomSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(\'\');\n\n    if (!emailInput.trim()) {\n      setErrorMsg(\'Por favor, ingresa una direcci\303\263n de correo.\');\n      return;\n    }\n    if (!emailInput.includes(\'@\')) {\n      setErrorMsg(\'Ingresa un correo electr\303\263nico de Google v\303\241lido.\');\n      return;\n    }\n\n    const computedName = nameInput.trim() || emailInput.split(\'@\')[0].replace(\'.\', \' \');\n    const formattedName = computedName.charAt(0).toUpperCase() + computedName.slice(1);\n\n    setLoading(true);\n    setTimeout(() => {\n      signInWithGoogle(emailInput.trim(), formattedName);\n      setLoading(false);\n    }, 1000);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-900 flex items-center justify-center p-4 font-sans text-xs select-none\" id=\"google-signin-wrapper\">\n      <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,rgba(14,165,233,0.08),transparent_50%)] pointer-events-none\"></div>\n      <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_70%_70%,rgba(99,102,241,0.08),transparent_50%)] pointer-events-none\"></div>\n\n      <div className=\"w-full max-w-md bg-slate-950 border border-slate-800 rounded-3xl p-8 shadow-2xl relative z-10 space-y-6\">\n        \n        {/* BRAND HEADER */}\n        <div className=\"text-center space-y-2\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-sky-500/10 rounded-full border border-sky-500/20 text-sky-400 font-mono text-[9px] uppercase tracking-widest\">\n            <Sparkles className=\"w-3 h-3 animate-pulse\" />\n            Acceso unificado\n          </div>\n          <div className=\"flex justify-center items-center gap-2 mt-2\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-sky-500/20\">\n              <Shield className=\"w-5 h-5 text-white\" />\n            </div>\n            <div className=\"text-left\">\n              <h2 className=\"text-xl font-black text-white tracking-tight\">ARES GYM</h2>\n              <p className=\"text-slate-400 text-[10px] uppercase font-mono tracking-widest -mt-1\">Portal de Acceso</p>\n            </div>\n          </div>\n          <p className=\"text-slate-400 text-xs mt-3\">\n            Para ingresar, inicia sesi\303\263n con un correo de Google. Esto determinar\303\241 si eres **Socio**, **Profesor** o **Administrador**.\n          </p>\n        </div>\n\n        {loading ? (\n          <div className=\"py-12 flex flex-col items-center justify-center space-y-4\">\n            <div className=\"relative\">\n              <div className=\"w-12 h-12 rounded-full border-4 border-slate-800 border-t-sky-500 animate-spin\"></div>\n              <div className=\"absolute inset-0 flex items-center justify-center\">\n                <svg className=\"w-5 h-5 text-sky-400\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                  <path d=\"M12.24 10.285V13.4h6.887c-.275 1.565-1.88 4.604-6.887 4.604-4.33 0-7.859-3.578-7.859-8s3.53-8 7.859-8c2.46 0 4.105 1.025 5.047 1.926l2.427-2.334C17.955 2.192 15.34 1 12.24 1 5.48 1 0 6.48 0 13s5.48 12 12.24 12c7.06 0 11.758-4.965 11.758-11.965 0-.807-.087-1.427-.193-1.75H12.24z\"/>\n                </svg>\n              </div>\n            </div>\n            <p className=\"text-slate-300 font-medium\">Verificando credenciales de Google...</p>\n            <p className=\"text-slate-500 text-[10px] font-mono\">auth.google.com/oauth/v2</p>\n          </div>\n        ) : (\n          <>\n            {/* GOOGLE SIGN IN BUTTON SIMULATOR OR SELECTOR */}\n            {!useCustom ? (\n              <div className=\"space-y-4\">\n                <div className=\"text-slate-400 font-semibold px-1 text-[10px] lg:text-xs uppercase tracking-wider\">\n                  Selecciona una cuenta de Google registrada o de prueba:\n                </div>\n\n                <div className=\"space-y-2.5 max-h-[300px] overflow-y-auto pr-1\">\n                  {demoAccounts.map((account) => (\n                    <button\n                      key={account.email}\n                      onClick={() => handleDemoSignIn(account.email, account.name)}\n                      className=\"w-full text-left bg-slate-900 hover:bg-slate-850 border border-slate-800 hover:border-slate-700 p-3.5 rounded-2xl transition-all cursor-pointer flex items-center justify-between group\"\n                    >\n                      <div className=\"flex items-center gap-3\">\n                        <img\n                          src={account.avatar}\n                          alt={account.name}\n                          className=\"w-9 h-9 rounded-full object-cover border border-slate-700 group-hover:border-slate-500\"\n                        />\n                        <div>\n                          <div className=\"font-bold text-white text-[13px] flex items-center gap-1.5\">\n                            {account.name}\n                            <span className={`text-[8px] font-mono font-bold px-1.5 py-0.2 rounded-md ${\n                              account.role === \'ADMIN\' ? \'bg-red-500/10 text-red-400 border border-red-500/20\' :\n                              account.role === \'OPERADOR\' ? \'bg-sky-500/10 text-sky-400 border border-sky-400/20\' :\n                              \'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20\'\n                            }`}>\n                              {account.role === \'OPERADOR\' ? \'PROFE\' : account.role}\n                            </span>\n                          </div>\n                          <p className=\"text-slate-400 text-[11px] font-mono mt-0.5\">{account.email}</p>\n                          <p className=\"text-slate-500 text-[9px] mt-0.5 font-sans italic\">{account.desc}</p>\n                        </div>\n                      </div>\n                      <ArrowRight className=\"w-4 h-4 text-slate-600 group-hover:text-sky-400 transition-colors\" />\n                    </button>\n                  ))}\n                </div>\n\n                <div className=\"relative py-2\">\n                  <div className=\"absolute inset-0 flex items-center\">\n                    <span className=\"w-full border-t border-slate-800\"></span>\n                  </div>\n                  <div className=\"relative flex justify-center text-xs\">\n                    <span className=\"bg-slate-950 px-2.5 text-[10px] text-slate-500 font-mono uppercase tracking-wider\">o ingresa</span>\n                  </div>\n                </div>\n\n                <button\n                  onClick={() => setUseCustom(true)}\n                  className=\"w-full bg-slate-950 hover:bg-slate-900 border border-slate-800 text-slate-350 hover:text-white font-bold py-3 px-4 rounded-xl transition-all flex items-center justify-center gap-2 cursor-pointer\"\n                >\n                  <Mail className=\"w-4 h-4 text-slate-450\" />\n                  Escribir otra cuenta de Google\n                </button>\n              </div>\n            ) : (\n              <form onSubmit={handleCustomSubmit} className=\"space-y-4\">\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"text-slate-400 font-bold uppercase text-[10px] tracking-wider\">Correo de Google Manual</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setUseCustom(false);\n                      setErrorMsg(\'\');\n                    }}\n                    className=\"text-sky-400 hover:text-sky-300 font-bold tracking-tight cursor-pointer\"\n                  >\n                    \342\206\220 Volver a cuentas\n                  </button>\n                </div>\n\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"text-slate-400 block mb-1 font-semibold text-[11px]\">Direcci\303\263n de Correo:</label>\n                    <div className=\"relative\">\n                      <input\n                        type=\"email\"\n                        value={emailInput}\n                        onChange={(e) => setEmailInput(e.target.value)}\n                        placeholder=\"ejemplo@gmail.com\"\n                        className=\"w-full bg-slate-900 border border-slate-800 text-slate-200 placeholder-slate-600 rounded-xl p-3.5 pl-10 pr-4 outline-none focus:border-sky-500 transition-colors font-medium text-xs\"\n                      />\n                      <Mail className=\"w-4 h-4 text-slate-500 absolute left-3.5 top-3.5\" />\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"text-slate-400 block mb-1 font-semibold text-[11px]\">Nombre Completo (Opcional):</label>\n                    <div className=\"relative\">\n                      <input\n                        type=\"text\"\n                        value={nameInput}\n                        onChange={(e) => setNameInput(e.target.value)}\n                        placeholder=\"Tob\303\255as Arraiza\"\n                        className=\"w-full bg-slate-900 border border-slate-800 text-slate-200 placeholder-slate-600 rounded-xl p-3.5 pl-10 pr-4 outline-none focus:border-sky-500 transition-colors font-medium text-xs\"\n                      />\n                      <User className=\"w-4 h-4 text-slate-500 absolute left-3.5 top-3.5\" />\n                    </div>\n                  </div>\n                </div>\n\n                {errorMsg && (\n                  <div className=\"bg-red-950/20 border border-red-900/40 text-red-400 p-3 rounded-lg text-[11px] font-semibold text-center\">\n                    {errorMsg}\n                  </div>\n                )}\n\n                <div className=\"bg-slate-900/60 p-3 rounded-xl border border-slate-850 text-slate-450 leading-relaxed text-[11px] font-sans\">\n                  <div className=\"font-bold text-slate-400 mb-0.5\">\360\237\222\241 Directivas de Simulaci\303\263n de Cuenta:</div>\n                  <ul className=\"list-disc list-inside space-y-1 text-[10px]\">\n                    <li>Ingresar <span className=\"font-bold text-red-400\">tobiasarraiza17@gmail.com</span> otorgar\303\241 permisos de **ADMIN**.</li>\n                    <li>Ingresar correos de socios registrados (ej. <span className=\"italic text-slate-300\">facundo.gomez@gmail.com</span>) cargar\303\241 su portal personal.</li>\n                    <li>Cualquier otro correo se registrar\303\241 autom\303\241ticamente como un nuevo **Socio Flexible**.</li>\n                  </ul>\n                </div>\n\n                <button\n                  type=\"submit\"\n                  className=\"w-full bg-gradient-to-tr from-sky-500 to-indigo-600 text-white font-bold py-3.5 px-4 rounded-xl hover:shadow-lg hover:shadow-sky-500/15 transition-all flex items-center justify-center gap-2 cursor-pointer text-xs\"\n                >\n                  <svg className=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                    <path d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" fill=\"#4285F4\"/>\n                    <path d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" fill=\"#34A853\"/>\n                    <path d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22-.09-.63z\" fill=\"#FBBC05\"/>\n                    <path d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z\" fill=\"#EA4335\"/>\n                  </svg>\n                  Iniciar sesi\303\263n con Google\n                </button>\n              </form>\n            )}\n          </>\n        )}\n\n        <div className=\"text-center text-slate-500 text-[10px] flex items-center justify-center gap-1.5\">\n          <Lock className=\"w-3.5 h-3.5 text-slate-600\" />\n          <span>Acceso certificado por Google Identity SSO</span>\n        </div>\n\n      </div>\n    </div>\n  );\n};"
    }
