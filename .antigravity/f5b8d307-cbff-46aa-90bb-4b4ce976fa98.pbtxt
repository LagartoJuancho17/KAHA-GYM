          text: "            <h3 className=\"text-sm font-sans font-bold uppercase tracking-wider text-zinc-500 mb-4\">Distribuci\303\263n por Plan contratado</h3>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
