  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "// src/App.tsx\nimport { useState } from \'react\';\nimport { GymProvider } from \'./GymContext\';\nimport { RoleSwitcher } from \'./components/RoleSwitcher\';\nimport { Dashboard } from \'./components/Dashboard\';\nimport { ClientesCRUD } from \'./components/ClientesCRUD\';\nimport { PlanesPricing } from \'./components/PlanesPricing\';\nimport { TurnosGrid } from \'./components/TurnosGrid\';\nimport { PagosLog } from \'./components/PagosLog\';\nimport { MorososControl } from \'./components/MorososControl\';\nimport { ProyeccionesTab } from \'./components/ProyeccionesTab\';\nimport { AuditLogView } from \'./components/AuditLogView\';\n\nimport { \n  Dribbble, Landmark, LayoutDashboard, Users, CreditCard, \n  CalendarRange, ShieldAlert, LineChart, ShieldCheck \n} from \'lucide-react\';\n\ntype TabID = \'DASHBOARD\' | \'CLIENTES\' | \'PLANES\' | \'TURNOS\' | \'PAGOS\' | \'MOROSIDAD\' | \'PROYECCIONES\' | \'AUDITORIA\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<TabID>(\'DASHBOARD\');\n  const [showAddPagoModal, setShowAddPagoModal] = useState(false);\n\n  const TAB_ITEMS = [\n    { id: \'DASHBOARD\' as TabID, label: \'Resumen\', icon: LayoutDashboard },\n    { id: \'CLIENTES\' as TabID, label: \'Socios\', icon: Users },\n    { id: \'PLANES\' as TabID, label: \'Planes\', icon: Dribbble },\n    { id: \'TURNOS\' as TabID, label: \'Cupos y Turnos\', icon: CalendarRange },\n    { id: \'PAGOS\' as TabID, label: \'Pagos e Ingresos\', icon: Landmark },\n    { id: \'MOROSIDAD\' as TabID, label: \'Control de Mora\', icon: ShieldAlert },\n    { id: \'PROYECCIONES\' as TabID, label: \'Previsiones\', icon: LineChart },\n    { id: \'AUDITORIA\' as TabID, label: \'Auditor\303\255a DB\', icon: ShieldCheck },\n  ];\n\n  const renderActiveTabContent = () => {\n    switch (activeTab) {\n      case \'DASHBOARD\':\n        return <Dashboard setActiveTab={(tab) => setActiveTab(tab as TabID)} />;\n      case \'CLIENTES\':\n        return <ClientesCRUD />;\n      case \'PLANES\':\n        return <PlanesPricing />;\n      case \'TURNOS\':\n        return <TurnosGrid />;\n      case \'PAGOS\':\n        return (\n          <PagosLog \n            showAddPagoModal={showAddPagoModal} \n            setShowAddPagoModal={setShowAddPagoModal} \n          />\n        );\n      case \'MOROSIDAD\':\n        return <MorososControl />;\n      case \'PROYECCIONES\':\n        return <ProyeccionesTab />;\n      case \'AUDITORIA\':\n        return <AuditLogView />;\n      default:\n        return <Dashboard setActiveTab={(tab) => setActiveTab(tab as TabID)} />;\n    }\n  };\n\n  return (\n    <GymProvider>\n      <div className=\"min-h-screen bg-[#fafafb] flex flex-col text-zinc-900 font-sans\" id=\"app-wrapper\">\n        {/* Floating Top Header: Branding + DB switcher */}\n        <RoleSwitcher />\n\n        {/* Tab Selection Header */}\n        <div className=\"bg-white border-b border-zinc-200 sticky top-0 z-40 shadow-xs\" id=\"navigation-tabs-bar\">\n          <div className=\"max-w-7xl mx-auto px-4 overflow-x-auto flex gap-1\">\n            {TAB_ITEMS.map(item => {\n              const Icon = item.icon;\n              const isSelected = activeTab === item.id;\n              \n              return (\n                <button\n                  key={item.id}\n                  onClick={() => setActiveTab(item.id)}\n                  className={`flex items-center gap-2 px-4 py-3.5 border-b-2 text-xs font-sans font-bold transition-all whitespace-nowrap outline-hidden ${\n                    isSelected \n                      ? \'border-black text-black bg-zinc-50/50\' \n                      : \'border-transparent text-zinc-500 hover:text-zinc-900 hover:border-zinc-300\'\n                  }`}\n                  id={`tab-btn-${item.id.toLowerCase()}`}\n                >\n                  <Icon className={`w-4 h-4 ${isSelected ? \'text-black\' : \'text-zinc-400\'}`} />\n                  {item.label}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Main View Area */}\n        <main className=\"flex-1 pb-16\">\n          {renderActiveTabContent()}\n        </main>\n      </div>\n    </GymProvider>\n  );\n}\n"
    }
