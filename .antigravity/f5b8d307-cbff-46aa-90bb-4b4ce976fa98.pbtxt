          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <div className=\"flex flex-col sm:flex-row items-center gap-6 justify-center\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            {/* SVG Simple Donut Chart */}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <div className=\"relative w-36 h-36 flex items-center justify-center\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <svg className=\"w-full h-full transform -rotate-90\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                <circle cx=\"72\" cy=\"72\" r=\"50\" fill=\"transparent\" stroke=\"#f4f4f5\" strokeWidth=\"18\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                {/* Dynamically segments. We have 4 plans, pre-calculate arcs for a standard representation */}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                {totalPlanSum > 0 ? (() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  let accumulatedOffset = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  const colores = [\'#09090b\', \'#3f3f46\', \'#22c55e\', \'#f59e0b\'];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  const r = 50;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  const circ = 2 * Math.PI * r;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  return planDistribucion.map((p, idx) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    if (p.cantidad === 0) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    const pctOfCircle = p.cantidad / totalPlanSum;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    const strokeDasharray = `${pctOfCircle * circ} ${circ}`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    const strokeDashoffset = -accumulatedOffset * circ;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    accumulatedOffset += pctOfCircle;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    return ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      <circle"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        key={p.nombre}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        cx=\"72\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        cy=\"72\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        r={r}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        fill=\"transparent\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        stroke={colores[idx % colores.length]}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        strokeWidth=\"18\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
