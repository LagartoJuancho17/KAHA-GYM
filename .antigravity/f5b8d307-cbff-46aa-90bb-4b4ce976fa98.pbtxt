  file_change {
    absolute_path_uri: "file:///src/components/SocioPanel.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "// src/components/SocioPanel.tsx\nimport React, { useState, useMemo } from \'react\';\nimport { useGym } from \'../GymContext\';\nimport { \n  MessageSquare, DollarSign, Calendar, Clock, \n  CheckCircle2, Trash2, User, Sparkles, \n  AlertTriangle, CreditCard, ExternalLink, RefreshCw\n} from \'lucide-react\';\n\nexport const SocioPanel: React.FC = () => {\n  const { \n    clientes, turnos, pagos, selectedSocioId, asignarTurnoVariable, planes\n  } = useGym();\n\n  const [activeDayTab, setActiveDayTab] = useState<\'LUNES\' | \'MARTES\' | \'MIERCOLES\' | \'JUEVES\' | \'VIERNES\'>(\'LUNES\');\n  const [successMessage, setSuccessMessage] = useState<string | null>(null);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  // Encontrar el socio logueado/simulado\n  const socio = useMemo(() => {\n    return clientes.find(c => c.id === selectedSocioId && c.activo) || null;\n  }, [clientes, selectedSocioId]);\n\n  // Pagos realizados por este socio\n  const misPagos = useMemo(() => {\n    if (!socio) return [];\n    return pagos.filter(p => p.cliente_id === socio.id)\n      .sort((a, b) => new Date(b.fecha_pago).getTime() - new Date(a.fecha_pago).getTime());\n  }, [pagos, socio]);\n\n  // Turnos del d\303\255a seleccionado\n  const turnosDelDia = useMemo(() => {\n    return turnos.filter(t => t.dia === activeDayTab);\n  }, [turnos, activeDayTab]);\n\n  // Plan contratado\n  const planSocio = useMemo(() => {\n    if (!socio) return null;\n    return planes.find(p => p.id === socio.plan_id) || null;\n  }, [planes, socio]);\n\n  const handleAsignarVariable = (turnoId: string) => {\n    if (!socio) return;\n    setSuccessMessage(null);\n    setErrorMessage(null);\n\n    const res = asignarTurnoVariable(socio.id, turnoId);\n    if (res.success) {\n      setSuccessMessage(res.message);\n      setTimeout(() => setSuccessMessage(null), 3000);\n    } else {\n      setErrorMessage(res.message);\n      setTimeout(() => setErrorMessage(null), 3000);\n    }\n  };\n\n  const handleLiberarVariable = () => {\n    if (!socio) return;\n    setSuccessMessage(null);\n    setErrorMessage(null);\n\n    const res = asignarTurnoVariable(socio.id, null);\n    if (res.success) {\n      setSuccessMessage(res.message);\n      setTimeout(() => setSuccessMessage(null), 3000);\n    } else {\n      setErrorMessage(res.message);\n      setTimeout(() => setErrorMessage(null), 3000);\n    }\n  };\n\n  if (!socio) {\n    return (\n      <div className=\"bg-white border border-slate-200 rounded-xl p-8 text-center max-w-md mx-auto my-12\" id=\"socio-panel-no-selected\">\n        <AlertTriangle className=\"w-12 h-12 text-amber-500 mx-auto mb-4\" />\n        <h3 className=\"text-lg font-bold text-slate-800\">Ning\303\272n Socio Simulado</h3>\n        <p className=\"text-slate-500 text-sm mt-2\">\n          Por favor, selecciona un socio activo utilizando el desplegable ubicado en la barra de control de la consola superior.\n        </p>\n      </div>\n    );\n  }\n\n  // Whatsapp Link Generator\n  const whatsappUrl = () => {\n    const phone = \"5491123456789\"; // Configured contact telephone (Argentina)\n    const textMessage = `Hola Ares Gym, soy el socio ${socio.nombre} ${socio.apellido}. Me contacto desde mi panel de cliente de la app para realizar una consulta sobre mis turnos y cuotas.`;\n    return `https://wa.me/${phone}?text=${encodeURIComponent(textMessage)}`;\n  };\n\n  return (\n    <div className=\"space-y-6\" id=\"socio-panel-container\">\n      {/* HEADER DE BIENVENIDA */}\n      <div className=\"bg-slate-900 text-white rounded-2xl p-6 shadow-sm border border-slate-800 relative overflow-hidden\" id=\"socio-welcome-header\">\n        <div className=\"absolute right-0 bottom-0 opacity-[0.03] pointer-events-none transform translate-y-6 translate-x-6\">\n          <Sparkles className=\"w-64 h-64\" />\n        </div>\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n          <div className=\"flex items-center gap-4\">\n            <div className=\"w-12 h-12 rounded-full bg-indigo-500/15 text-indigo-400 font-bold text-base flex items-center justify-center border border-indigo-500/20 shadow-md\">\n              <User className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <span className=\"text-indigo-400 text-[10px] font-bold uppercase tracking-widest font-mono\">Panel de Socio Particular</span>\n              <h2 className=\"text-xl font-bold tracking-tight mt-0.5 text-slate-100\">{socio.nombre} {socio.apellido}</h2>\n              <p className=\"text-xs text-slate-400 font-sans mt-0.5\">{socio.email} \342\200\242 {socio.telefono || \'Sin tel\303\251fono\'}</p>\n            </div>\n          </div>\n          \n          <div className=\"flex flex-wrap gap-2\">\n            <div className=\"bg-slate-850 px-3 py-1.5 rounded-lg border border-slate-800 text-slate-300 text-xs flex items-center gap-1.5\">\n              <span className=\"text-slate-500 font-sans\">Membres\303\255a:</span>\n              <span className=\"font-bold text-slate-100\">{planSocio ? planSocio.nombre : \'Abono General\'}</span>\n            </div>\n            <div className={`px-3 py-1.5 rounded-lg border text-xs font-bold ${\n              socio.estado === \'ACTIVO\'\n                ? \'bg-emerald-500/10 text-emerald-400 border-emerald-500/20\'\n                : \'bg-rose-500/10 text-rose-400 border-rose-500/20\'\n            }`}>\n              {socio.estado === \'ACTIVO\' ? \'Al D\303\255a (Suscripci\303\263n Activa)\' : `Moroso (Deuda: $${socio.deuda_acumulada.toLocaleString(\'es-AR\')})`}\n            </div>\n          </div>\n        </div>\n\n        {/* REGLA SEMANAL INDICADOR */}\n        <div className=\"mt-5 pt-5 border-t border-slate-850 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-400 font-sans\">\n          <div className=\"flex flex-wrap items-center gap-4\">\n            <div className=\"flex items-center gap-1.5\">\n              <div className=\"w-2.5 h-2.5 rounded-full bg-sky-500\"></div>\n              <span>Fijos contratados: <strong className=\"text-slate-200\">{socio.turnos_fijos.length} / 2</strong></span>\n            </div>\n            <div className=\"flex items-center gap-1.5\">\n              <div className=\"w-2.5 h-2.5 rounded-full bg-violet-500\"></div>\n              <span>Variable actual: <strong className=\"text-slate-200\">{socio.turno_variable ? \'1 / 1\' : \'0 / 1\'}</strong></span>\n            </div>\n          </div>\n          <p className=\"text-[10px] text-slate-400 bg-slate-950/40 border border-slate-850 py-1 px-2.5 rounded-md font-mono\">\n            R\303\251gimen: 2 D\303\255as Fijos + 1 D\303\255a Variable\n          </p>\n        </div>\n      </div>\n\n      {/* ERROR & SUCCESS MESSAGES */}\n      {successMessage && (\n        <div className=\"bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl text-xs font-semibold flex items-center gap-2 animate-pulse\">\n          <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n          <span>{successMessage}</span>\n        </div>\n      )}\n      {errorMessage && (\n        <div className=\"bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 rounded-xl text-xs font-semibold flex items-center gap-2\">\n          <AlertTriangle className=\"w-4 h-4 text-rose-600\" />\n          <span>{errorMessage}</span>\n        </div>\n      )}\n\n      {/* SECCI\303\223N TURNERA DE TIEMPO REAL */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* COL IZQUIERDA: RESUMEN TURNOS ACTUALES & VIA WHATSAPP & RETROALIMENTACION */}\n        <div className=\"space-y-6 lg:col-span-1\">\n          {/* MIS TURNOS ACTUALES ESTADOS */}\n          <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs\" id=\"socio-mis-turnos-resumen\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-400 font-mono flex items-center gap-1.5 mb-4\">\n              <Calendar className=\"w-4 h-4 text-slate-400\" />\n              Sede Reservas Activas\n            </h3>\n            \n            <div className=\"space-y-3\">\n              {/* TURNOS FIJOS */}\n              <div>\n                <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wide\">Mis Turnos Fijos (2 m\303\241ximos)</span>\n                {socio.turnos_fijos.length === 0 ? (\n                  <p className=\"text-slate-400 text-xs italic mt-1 font-sans\">No tienes turnos fijos asignados en administraci\303\263n.</p>\n                ) : (\n                  <div className=\"space-y-1.5 mt-1.5\">\n                    {socio.turnos_fijos.map(tF => {\n                      const [diaStr, horaStr] = tF.split(\'-\');\n                      return (\n                        <div key={tF} className=\"bg-sky-50 text-sky-800 text-xs px-3 py-2 rounded-lg font-semibold flex justify-between items-center border border-sky-100\">\n                          <span className=\"font-mono tracking-tight\">{diaStr} \342\200\242 {horaStr} hs</span>\n                          <span className=\"bg-sky-100 text-sky-950 px-1.5 py-0.5 rounded text-[9px] uppercase font-bold tracking-wider\">Fijo</span>\n                        </div>\n                      );\n                    })}\n                  </div>\n                )}\n              </div>\n\n              {/* TURNO VARIABLE */}\n              <div className=\"pt-3 border-t border-slate-100\">\n                <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wide\">Mi Turno Variable (1 reservable)</span>\n                {socio.turno_variable ? (\n                  <div className=\"mt-1.5 space-y-1.5\">\n                    {(() => {\n                      const [diaStr, horaStr] = socio.turno_variable.split(\'-\');\n                      return (\n                        <div className=\"bg-violet-50 text-violet-800 text-xs px-3 py-2 rounded-lg font-semibold flex justify-between items-center border border-violet-100\">\n                          <span className=\"font-mono tracking-tight\">{diaStr} \342\200\242 {horaStr} hs</span>\n                          <button\n                            onClick={handleLiberarVariable}\n                            className=\"bg-violet-100 hover:bg-violet-200 text-violet-900 p-1 rounded-md transition-all cursor-pointer\"\n                            title=\"Desasignar Reserva Variable\"\n                          >\n                            <Trash2 className=\"w-3.5 h-3.5\" />\n                          </button>\n                        </div>\n                      );\n                    })()}\n                  </div>\n                ) : (\n                  <div className=\"mt-1.5 bg-yellow-50 text-yellow-800 text-[11px] p-3 rounded-lg border border-yellow-100\">\n                    <p className=\"font-semibold leading-normal\">\n                      A\303\272n no has seleccionado tu \"Turno Variable\" de la semana.\n                    </p>\n                    <p className=\"text-[10px] text-yellow-700 mt-1\">\n                      Elige cualquier horario con cupos de la grilla del d\303\255a en tiempo real.\n                    </p>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n\n          {/* SOPORTE WHATSAPP DIRECTO */}\n          <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs\" id=\"socio-whatsapp-channel\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-400 font-mono flex items-center gap-1.5 mb-2\">\n              <MessageSquare className=\"w-4 h-4 text-emerald-500\" />\n              Soporte Ares Gym\n            </h3>\n            <p className=\"text-slate-500 text-xs leading-relaxed mb-4 font-sans\">\n              \302\277Quieres modificar alg\303\272n turno fijo o tienes alguna duda de cobranza? Chatea directo con nuestros profesores por WhatsApp de forma directa.\n            </p>\n            <a\n              href={whatsappUrl()}\n              target=\"_blank\"\n              rel=\"noreferrer\"\n              className=\"w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2.5 px-4 rounded-lg text-xs flex items-center justify-center gap-2 transition-all shadow-xs\"\n            >\n              <span>Enviar WhatsApp Directo</span>\n              <ExternalLink className=\"w-3.5 h-3.5\" />\n            </a>\n          </div>\n\n          {/* HISTORIAL DE PAGOS */}\n          <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs\" id=\"socio-registro-pagos\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-400 font-mono flex items-center gap-1.5 mb-3\">\n              <CreditCard className=\"w-4 h-4 text-slate-450\" />\n              Mis Pagos Registrados\n            </h3>\n\n            {misPagos.length === 0 ? (\n              <div className=\"text-center py-4 text-slate-400 text-xs italic\">\n                A\303\272n no posees abonos procesados en el sistema actual.\n              </div>\n            ) : (\n              <div className=\"space-y-2.5 max-h-56 overflow-y-auto pr-1\">\n                {misPagos.map(p => (\n                  <div key={p.id} className=\"bg-slate-50 hover:bg-slate-100 p-2.5 rounded-lg border border-slate-200/50 flex justify-between items-center text-xs\">\n                    <div>\n                      <p className=\"font-semibold text-slate-800\">Mes: {p.mes_correspondiente}</p>\n                      <p className=\"text-[9px] text-slate-400 font-mono mt-0.5\">Hash: {p.hash_transaccion?.slice(0,12)}...</p>\n                      <p className=\"text-[9px] text-slate-500 font-sans mt-0.5\">{new Date(p.fecha_pago).toLocaleDateString(\'es-AR\')}</p>\n                    </div>\n                    <div className=\"text-right\">\n                      <p className=\"font-mono font-bold text-slate-900\">${p.monto.toLocaleString(\'es-AR\')}</p>\n                      <p className=\"text-[9px] bg-emerald-100 text-emerald-800 px-1 py-0.2 rounded font-bold uppercase inline-block mt-0.5 tracking-wider\">\n                        {p.medio_pago}\n                      </p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* COL DERECHA: TURNERA DE TIEMPO REAL */}\n        <div className=\"lg:col-span-2 space-y-4\">\n          <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs\" id=\"socio-turnera-realtime bg\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4\">\n              <div>\n                <h3 className=\"text-sm font-bold text-slate-800 flex items-center gap-1.5\">\n                  <Calendar className=\"w-4.5 h-4.5 text-indigo-500\" />\n                  Turnera de Tiempo Real\n                </h3>\n                <p className=\"text-slate-500 text-xs font-sans mt-0.5\">Monitorea los cupos d\303\255a a d\303\255a y elige tu turno variable</p>\n              </div>\n\n              {/* LEYENDAS */}\n              <div className=\"flex flex-wrap items-center gap-3 text-[10px] text-slate-500 font-mono\">\n                <span className=\"flex items-center gap-1\">\n                  <span className=\"w-2.5 h-2.5 bg-sky-100 rounded-sm inline-block border border-sky-200\"></span> Fijo\n                </span>\n                <span className=\"flex items-center gap-1\">\n                  <span className=\"w-2.5 h-2.5 bg-violet-100 rounded-sm inline-block border border-violet-200\"></span> Variable\n                </span>\n              </div>\n            </div>\n\n            {/* BARRA SEGMENTADA DE D\303\215AS (LUNES A VIERNES) */}\n            <div className=\"grid grid-cols-5 bg-slate-100 p-1 rounded-xl border border-slate-200 gap-1\" id=\"socio-dias-selector-segment\">\n              {([\'LUNES\', \'MARTES\', \'MIERCOLES\', \'JUEVES\', \'VIERNES\'] as const).map(dia => {\n                const isActive = activeDayTab === dia;\n                return (\n                  <button\n                    key={dia}\n                    onClick={() => setActiveDayTab(dia)}\n                    className={`py-2 text-center text-xs font-bold rounded-lg transition-all cursor-pointer ${\n                      isActive \n                        ? \'bg-slate-900 text-white shadow-sm\' \n                        : \'text-slate-500 hover:text-slate-900 hover:bg-slate-200\'\n                    }`}\n                  >\n                    {dia === \'MIERCOLES\' ? \'MI\303\211RCOLES\' : dia}\n                  </button>\n                );\n              })}\n            </div>\n\n            {/* LISTADO DE HORAS DEL D\303\215A SELECCIONADO */}\n            <div className=\"space-y-2 mt-4\" id=\"socio-horas-slots-list\">\n              {turnosDelDia.length === 0 ? (\n                <div className=\"text-center py-8 text-slate-400 font-sans text-xs italic\">\n                  No hay horarios dados de alta para el d\303\255a estipulado.\n                </div>\n              ) : (\n                turnosDelDia.map(turno => {\n                  // Calcular ocupaci\303\263n real detallada\n                  const fijosCount = turno.asignados_ids.length;\n                  const variablesCount = clientes.filter(c => c.activo && c.turno_variable === turno.id).length;\n                  const totalOccupied = fijosCount + variablesCount;\n                  \n                  // Indicators\n                  const holdsMyFijo = socio.turnos_fijos.includes(turno.id);\n                  const holdsMyVariable = socio.turno_variable === turno.id;\n                  const isFull = totalOccupied >= turno.cupo_maximo;\n\n                  return (\n                    <div \n                      key={turno.id}\n                      className={`\n                        p-3.5 rounded-xl border transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3\n                        ${holdsMyFijo ? \'bg-sky-50/50 border-sky-200\' : \'\'}\n                        ${holdsMyVariable ? \'bg-violet-50 border-violet-300 ring-1 ring-violet-400/20 shadow-xs\' : \'\'}\n                        ${!holdsMyFijo && !holdsMyVariable ? \'bg-white border-slate-200 hover:border-slate-300\' : \'\'}\n                      `}\n                    >\n                      {/* DETALLE HORARIO */}\n                      <div className=\"flex items-center gap-3\">\n                        <div className={`p-2 rounded-lg ${holdsMyFijo ? \'bg-sky-100 text-sky-800\' : holdsMyVariable ? \'bg-violet-100 text-violet-800\' : \'bg-slate-100 text-slate-600\'}`}>\n                          <Clock className=\"w-4 h-4\" />\n                        </div>\n                        <div>\n                          <p className=\"font-bold text-slate-800 leading-none\">{turno.hora} hs</p>\n                          \n                          {/* COBERTURA ACENTUADO */}\n                          <div className=\"flex flex-wrap items-center gap-1.5 mt-1\">\n                            <span className={`text-[10px] font-bold px-1.5 py-0.2 rounded ${isFull ? \'bg-rose-50 text-rose-700\' : \'bg-slate-100 text-slate-600\'}`}>\n                              Cupos: {totalOccupied} / {turno.cupo_maximo}\n                            </span>\n                            <span className=\"text-[9px] text-slate-400 font-mono\">\n                              ({fijosCount} fijos + {variablesCount} variables)\n                            </span>\n                          </div>\n                        </div>\n                      </div>\n\n                      {/* CONFLICTO O ACCI\303\223N */}\n                      <div className=\"flex items-center gap-2 self-start sm:self-center\">\n                        {holdsMyFijo && (\n                          <span className=\"bg-sky-100 text-sky-800 text-[10px] font-extrabold px-2.5 py-1 rounded-md uppercase tracking-wider\">\n                            Tu Turno Fijo\n                          </span>\n                        )}\n\n                        {holdsMyVariable && (\n                          <div className=\"flex items-center gap-1.5\">\n                            <span className=\"bg-violet-600 text-white text-[10px] font-extrabold px-2.5 py-1 rounded-md uppercase tracking-wider flex items-center gap-1 animate-pulse\">\n                              <span>Tu Turno Variable</span>\n                            </span>\n                            <button\n                              onClick={() => handleLiberarVariable()}\n                              className=\"text-red-500 hover:text-red-700 hover:bg-red-50 p-1.5 rounded-lg border border-red-200/40 bg-white transition-colors cursor-pointer text-[10px] font-bold\"\n                              title=\"Liberar este turno variable\"\n                            >\n                              Liberar\n                            </button>\n                          </div>\n                        )}\n\n                        {!holdsMyFijo && !holdsMyVariable && (\n                          <button\n                            onClick={() => handleAsignarVariable(turno.id)}\n                            disabled={isFull}\n                            className={`\n                              px-3 py-1.5 rounded-lg text-xs font-bold font-sans transition-all cursor-pointer\n                              ${isFull \n                                ? \'bg-slate-100 text-slate-400 border border-slate-200 cursor-not-allowed\' \n                                : \'bg-slate-900 border border-slate-900 text-white hover:bg-slate-800\'\n                              }\n                            `}\n                          >\n                            {isFull ? \'Completo\' : \'Reservar Variable\'}\n                          </button>\n                        )}\n                      </div>\n                    </div>\n                  );\n                })\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
