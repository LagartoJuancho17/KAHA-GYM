          text: "        {/* GR\303\201FICO 2: CLIENTES POR PLAN (TORTA / DONA) */}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        <div className=\"bg-white border border-zinc-200 p-6 rounded-xl shadow-sm flex flex-col justify-between\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
