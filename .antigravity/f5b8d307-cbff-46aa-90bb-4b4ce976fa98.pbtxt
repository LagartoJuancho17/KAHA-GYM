        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Requisitos Previos"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Tener instalado **Node.js** (versi\303\263n 18 o superior)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Instrucciones paso a paso para usuarios:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. **Clonar o descargar el proyecto**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   Extrae el archivo ZIP en una carpeta de tu ordenador."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. **Instalar Dependencias**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
