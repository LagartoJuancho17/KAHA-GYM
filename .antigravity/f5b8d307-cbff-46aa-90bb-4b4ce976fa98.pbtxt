      replacement_content: "        {/* LOGGED CONTEXT CARD (Dynamic Google user) */}\n        <div className=\"pt-3 border-t border-slate-900 mt-6 flex flex-col gap-2.5\" id=\"sidebar-user-context-card\">\n          <div className=\"flex items-center gap-2.5\">\n            {googleUser?.picture ? (\n              <img \n                src={googleUser.picture} \n                alt={googleUser.name} \n                className=\"w-9 h-9 rounded-full object-cover border border-slate-800\"\n                referrerPolicy=\"no-referrer\"\n              />\n            ) : (\n              <div className=\"w-8 h-8 rounded-full bg-sky-500/20 text-sky-400 font-extrabold text-xs flex items-center justify-center border border-sky-500/10\">\n                {googleUser?.name ? googleUser.name.slice(0, 2).toUpperCase() : \'G\'}\n              </div>\n            )}\n            <div className=\"min-w-0 flex-1\">\n              <p className=\"text-[11px] font-bold text-slate-200 truncate leading-none\">\n                {googleUser?.name || \'Usuario Google\'}\n              </p>\n              <p className=\"text-[9px] text-slate-500 font-mono truncate mt-1 leading-none\" title={googleUser?.email}>\n                {googleUser?.email || \'N/A\'}\n              </p>\n            </div>\n            <div className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse shrink-0\" title=\"Verificado con Google SSO\"></div>\n          </div>\n          \n          <button \n            onClick={signOutGoogle}\n            className=\"w-full py-1.5 bg-slate-900 hover:bg-rose-950/40 text-slate-400 hover:text-red-400 border border-slate-805 hover:border-red-950/50 rounded-lg text-[9px] font-bold transition-all flex items-center justify-center gap-1 cursor-pointer\"\n            id=\"sidebar-signout-trigger-google\"\n          >\n            Cerrar Sesi\303\263n Google\n          </button>\n        </div>"
