        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. **Configurar el Entorno**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   El sistema funciona por defecto en un entorno de simulaci\303\263n local interactivo. Si deseas conectarlo un proyecto f\303\255sico en la nube con Supabase, renombra `.env.example` a `.env` y completa la inicializaci\303\263n con el script SQL de esquemas."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. **Compilar y Arrancar el Servidor**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   Inicia el servidor local de desarrollo ejecutando:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   ```bash"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   npm run dev"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   ```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   Abre tu navegador predilecto en `http://localhost:3000` para iniciar la gesti\303\263n operativa del gimnasio."
