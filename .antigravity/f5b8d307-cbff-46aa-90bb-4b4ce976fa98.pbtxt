        target_content: "// src/components/RoleSwitcher.tsx\nimport React from \'react\';\nimport { useGym } from \'../GymContext\';\nimport { Shield, Sparkles, RefreshCw, Clock } from \'lucide-react\';\n\nexport const RoleSwitcher: React.FC = () => {\n  const { rolActivo, setRolActivo, borrarHistorial } = useGym();\n\n  return (\n    <div className=\"bg-zinc-900 text-white py-3 px-6 border-b border-zinc-800 flex flex-col md:flex-row justify-between items-center gap-4 text-sm\" id=\"role-switcher-container\">\n      <div className=\"flex items-center gap-3\">\n        <div className=\"bg-amber-500/10 text-amber-400 p-2 rounded-lg\" id=\"gym-logo-badge\">\n          <Sparkles className=\"w-5 h-5\" />\n        </div>\n        <div>\n          <h1 className=\"font-sans font-semibold tracking-tight text-base\">Ares Gym</h1>\n          <p className=\"text-zinc-400 text-xs font-sans\">Sistema de Gesti\303\263n de Clientes y Turnos \342\200\224 <span className=\"font-semibold text-amber-400 font-mono\">ARGENTINA \360\237\207\246\360\237\207\267</span></p>\n        </div>\n      </div>\n\n      <div className=\"flex flex-wrap items-center gap-4\">\n        {/* Argentina Timezone Display */}\n        <div className=\"flex items-center gap-2 text-zinc-400 bg-zinc-805/40 px-3 py-1.5 rounded-md border border-zinc-700/30 text-xs font-mono\">\n          <Clock className=\"w-3.5 h-3.5 text-zinc-400\" />\n          <span>America/Argentina/Buenos_Aires</span>\n        </div>\n\n        {/* Roles Toggles */}\n        <div className=\"flex items-center bg-zinc-950 p-1 rounded-lg border border-zinc-800 gap-1\">\n          <button\n            onClick={() => setRolActivo(\'ADMIN\')}\n            className={`px-3 py-1.5 rounded-md transition-all font-medium flex items-center gap-1.5 text-xs ${\n              rolActivo === \'ADMIN\'\n                ? \'bg-amber-500 text-black font-semibold shadow-sm shadow-amber-500/10\'\n                : \'text-zinc-400 hover:text-white\'\n            }`}\n            id=\"role-btn-admin\"\n          >\n            <Shield className=\"w-3.5 h-3.5\" />\n            Admin (Acceso Total)\n          </button>\n          <button\n            onClick={() => setRolActivo(\'OPERADOR\')}\n            className={`px-3 py-1.5 rounded-md transition-all font-medium flex items-center gap-1.5 text-xs ${\n              rolActivo === \'OPERADOR\'\n                ? \'bg-zinc-800 text-white shadow-sm shadow-black\'\n                : \'text-zinc-400 hover:text-white\'\n            }`}\n            id=\"role-btn-operator\"\n          >\n            Operador (Limitado)\n          </button>\n        </div>\n\n        {/* RESET SIMULATION TRIGGER */}\n        <button\n          onClick={() => {\n            if (confirm(\'\302\277Est\303\241s seguro que deseas restablecer los datos de simulaci\303\263n al estado base cargado desde el SEED SQL?\')) {\n              borrarHistorial();\n            }\n          }}\n          className=\"text-zinc-400 hover:text-red-400 p-2 bg-zinc-800/30 hover:bg-red-500/5 rounded-md border border-zinc-800 hover:border-red-500/10 transition-colors flex items-center gap-1.5 text-xs font-medium\"\n          title=\"Restaurar toda la Base\"\n          id=\"btn-re-inicializar\"\n        >\n          <RefreshCw className=\"w-3.5 h-3.5\" />\n          Restablecer Base\n        </button>\n      </div>\n    </div>\n  );\n};"
