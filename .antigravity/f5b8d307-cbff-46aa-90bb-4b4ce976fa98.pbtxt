      replacement_content: "        {/* Roles Toggles */}\n        <div className=\"flex items-center bg-slate-950 p-1 rounded-lg border border-slate-800 gap-1\">\n          <button\n            onClick={() => setRolActivo(\'ADMIN\')}\n            className={`px-3 py-1 rounded-md transition-all font-semibold flex items-center gap-1.5 text-[10px] cursor-pointer ${\n              rolActivo === \'ADMIN\'\n                ? \'bg-sky-500 text-slate-950 shadow-sm shadow-sky-500/10\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n            id=\"role-btn-admin\"\n          >\n            <Shield className=\"w-3 h-3\" />\n            ADMIN\n          </button>\n          <button\n            onClick={() => setRolActivo(\'OPERADOR\')}\n            className={`px-3 py-1 rounded-md transition-all font-semibold flex items-center gap-1.5 text-[10px] cursor-pointer ${\n              rolActivo === \'OPERADOR\'\n                ? \'bg-slate-800 text-slate-200 shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n            id=\"role-btn-operator\"\n          >\n            OPERADOR\n          </button>\n          <button\n            onClick={() => setRolActivo(\'SOCIO\')}\n            className={`px-3 py-1 rounded-md transition-all font-semibold flex items-center gap-1.5 text-[10px] cursor-pointer ${\n              rolActivo === \'SOCIO\'\n                ? \'bg-indigo-600 text-white shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n            id=\"role-btn-socio\"\n          >\n            <User className=\"w-3 h-3\" />\n            SOCIO (VISTA CLIENTE)\n          </button>\n        </div>\n\n        {/* Selected Socio Dropdown (Only visible if SOCIO is active) */}\n        {rolActivo === \'SOCIO\' && (\n          <div className=\"flex items-center gap-1.5 bg-slate-950/80 px-2 py-1 rounded-lg border border-slate-800\">\n            <span className=\"text-slate-400 text-[10px] font-sans font-medium\">Socio Activo:</span>\n            <select\n              value={selectedSocioId || \'\'}\n              onChange={(e) => setSelectedSocioId(e.target.value || null)}\n              className=\"bg-slate-900 border border-slate-800 text-slate-100 text-[10px] rounded px-1.5 py-0.5 outline-none font-medium cursor-pointer\"\n            >\n              <option value=\"\" disabled>Seleccione socio...</option>\n              {clientes.filter(c => c.activo).map(c => (\n                <option key={c.id} value={c.id}>\n                  {c.apellido}, {c.nombre}\n                </option>\n              ))}\n            </select>\n          </div>\n        )}"
