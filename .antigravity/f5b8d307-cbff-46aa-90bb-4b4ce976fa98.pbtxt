  file_change {
    absolute_path_uri: "file:///src/components/RoleSwitcher.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "export const RoleSwitcher: React.FC = () => {\n  const { rolActivo, setRolActivo, borrarHistorial, clientes, selectedSocioId, setSelectedSocioId } = useGym();\n\n  return (\n    <div className=\"bg-slate-900 text-slate-100 py-2.5 px-6 border-b border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4 text-xs\" id=\"role-switcher-container\">\n      <div className=\"flex items-center gap-3\">\n        <div className=\"bg-sky-500/10 text-sky-400 p-2 rounded-lg border border-sky-450/20\" id=\"gym-logo-badge\">\n          <Sparkles className=\"w-4 h-4\" />\n        </div>\n        <div>\n          <h1 className=\"font-sans font-bold tracking-tight text-sm text-slate-150\">Ares Gym \342\200\224 Control de Consola</h1>\n          <p className=\"text-slate-400 text-[10px] font-sans\">Canal Operativo Reactivo \342\200\224 <span className=\"font-semibold text-sky-400 font-mono\">RG-2026 \360\237\207\246\360\237\207\267</span></p>\n        </div>\n      </div>\n\n      <div className=\"flex flex-wrap items-center gap-4\">\n        {/* Argentina Timezone Display */}\n        <div className=\"flex items-center gap-2 text-slate-400 bg-slate-950/40 px-3 py-1.5 rounded-md border border-slate-800/50 text-[10px] font-mono\">\n          <Clock className=\"w-3.5 h-3.5 text-slate-500\" />\n          <span>UTC-3 (Bs As)</span>\n        </div>\n\n        {/* Roles Toggles */}\n        <div className=\"flex items-center bg-slate-950 p-1 rounded-lg border border-slate-800 gap-1\">\n          <button\n            onClick={() => setRolActivo(\'ADMIN\')}\n            className={`px-3 py-1 rounded-md transition-all font-semibold flex items-center gap-1.5 text-[10px] cursor-pointer ${\n              rolActivo === \'ADMIN\'\n                ? \'bg-sky-500 text-slate-950 shadow-sm shadow-sky-500/10\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n            id=\"role-btn-admin\"\n          >\n            <Shield className=\"w-3 h-3\" />\n            ADMIN\n          </button>\n          <button\n            onClick={() => setRolActivo(\'OPERADOR\')}\n            className={`px-3 py-1 rounded-md transition-all font-semibold flex items-center gap-1.5 text-[10px] cursor-pointer ${\n              rolActivo === \'OPERADOR\'\n                ? \'bg-slate-800 text-slate-200 shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n            id=\"role-btn-operator\"\n          >\n            OPERADOR\n          </button>\n          <button\n            onClick={() => setRolActivo(\'SOCIO\')}\n            className={`px-3 py-1 rounded-md transition-all font-semibold flex items-center gap-1.5 text-[10px] cursor-pointer ${\n              rolActivo === \'SOCIO\'\n                ? \'bg-indigo-600 text-white shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n            id=\"role-btn-socio\"\n          >\n            <User className=\"w-3 h-3\" />\n            SOCIO (VISTA CLIENTE)\n          </button>\n        </div>"
      replacement_content: "export const RoleSwitcher: React.FC = () => {\n  const { \n    rolActivo, setRolActivo, borrarHistorial, clientes, \n    selectedSocioId, setSelectedSocioId, googleUser \n  } = useGym();\n\n  // If user is Google-logged-in as SOCIO, hide simulation switcher entirely\n  if (googleUser?.role === \'SOCIO\') {\n    return null;\n  }\n\n  const isOperatorBound = googleUser?.role === \'OPERADOR\';\n\n  return (\n    <div className=\"bg-slate-900 text-slate-100 py-2.5 px-6 border-b border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4 text-xs\" id=\"role-switcher-container\">\n      <div className=\"flex items-center gap-3\">\n        <div className=\"bg-sky-500/10 text-sky-400 p-2 rounded-lg border border-sky-450/20\" id=\"gym-logo-badge\">\n          <Sparkles className=\"w-4 h-4\" />\n        </div>\n        <div>\n          <h1 className=\"font-sans font-bold tracking-tight text-sm text-slate-150\">Ares Gym \342\200\224 Control de Consola</h1>\n          <p className=\"text-slate-400 text-[10px] font-sans\">Canal Operativo Reactivo \342\200\224 <span className=\"font-semibold text-sky-400 font-mono\">RG-2026 \360\237\207\246\360\237\207\267</span></p>\n        </div>\n      </div>\n\n      <div className=\"flex flex-wrap items-center gap-4\">\n        {/* Argentina Timezone Display */}\n        <div className=\"flex items-center gap-2 text-slate-400 bg-slate-950/40 px-3 py-1.5 rounded-md border border-slate-800/50 text-[10px] font-mono\">\n          <Clock className=\"w-3.5 h-3.5 text-slate-500\" />\n          <span>UTC-3 (Bs As)</span>\n        </div>\n\n        {/* Roles Toggles */}\n        <div className=\"flex items-center bg-slate-950 p-1 rounded-lg border border-slate-800 gap-1\">\n          <button\n            onClick={() => {\n              if (isOperatorBound) return;\n              setRolActivo(\'ADMIN\');\n            }}\n            disabled={isOperatorBound}\n            title={isOperatorBound ? \"Acceso restringido: Iniciaste sesi\303\263n como Profesor\" : \"Simular administrador\"}\n            className={`px-3 py-1 rounded-md transition-all font-semibold flex items-center gap-1.5 text-[10px] ${\n              isOperatorBound \n                ? \'opacity-35 cursor-not-allowed text-slate-500\' \n                : \'cursor-pointer\'\n            } ${\n              rolActivo === \'ADMIN\'\n                ? \'bg-sky-500 text-slate-950 shadow-sm shadow-sky-500/10\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n            id=\"role-btn-admin\"\n          >\n            <Shield className=\"w-3 h-3\" />\n            ADMIN\n          </button>\n          <button\n            onClick={() => setRolActivo(\'OPERADOR\')}\n            className={`px-3 py-1 rounded-md transition-all font-semibold flex items-center gap-1.5 text-[10px] cursor-pointer ${\n              rolActivo === \'OPERADOR\'\n                ? \'bg-slate-800 text-slate-200 shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n            id=\"role-btn-operator\"\n          >\n            PROFE\n          </button>\n          <button\n            onClick={() => setRolActivo(\'SOCIO\')}\n            className={`px-3 py-1 rounded-md transition-all font-semibold flex items-center gap-1.5 text-[10px] cursor-pointer ${\n              rolActivo === \'SOCIO\'\n                ? \'bg-indigo-600 text-white shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n            id=\"role-btn-socio\"\n          >\n            <User className=\"w-3 h-3\" />\n            SOCIO (VISTA CLIENTE)\n          </button>\n        </div>"
    }
