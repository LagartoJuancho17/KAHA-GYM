      original_chunk {
        target_content: "    <div className=\"space-y-8 p-6 max-w-7xl mx-auto\" id=\"dashboard-tab-panel\">\n      {/* SECCI\303\223N BIENVENIDA */}\n      <div className=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n        <div>\n          <h2 className=\"text-2xl font-sans font-bold tracking-tight text-zinc-950\">Panel General</h2>\n          <p className=\"text-zinc-500 font-sans text-sm\">Resumen operativo para el mes de <span className=\"font-semibold text-zinc-950\">Mayo 2026</span></p>\n        </div>\n        \n        {/* BOTONERA ACCESOS RAPIDOS */}\n        <div className=\"flex flex-wrap gap-2\">\n          <button\n            onClick={() => {\n              if (setShowAddClienteModal) {\n                setShowAddClienteModal(true);\n              }\n              setActiveTab(\'CLIENTES\');\n            }}\n            className=\"bg-black hover:bg-zinc-800 text-white px-3 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm\"\n            id=\"quick-add-client-btn\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            Nuevo Cliente\n          </button>\n          \n          <button\n            onClick={() => {\n              if (setShowAddPagoModal) {\n                setShowAddPagoModal(true);\n              }\n              setActiveTab(\'PAGOS\');\n            }}\n            className=\"bg-zinc-100 hover:bg-zinc-200 text-zinc-950 border border-zinc-200 px-3 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm\"\n            id=\"quick-add-payment-btn\"\n          >\n            <Receipt className=\"w-4 h-4 text-zinc-600\" />\n            Registrar Pago\n          </button>\n          \n          <button\n            onClick={() => {\n              setActiveTab(\'turnos\');\n            }}\n            className=\"bg-zinc-100 hover:bg-zinc-200 text-zinc-950 border border-zinc-200 px-3 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm\"\n            id=\"quick-schedule-btn\"\n          >\n            <Grid className=\"w-4 h-4 text-zinc-600\" />\n            Grilla Turnos\n          </button>\n        </div>\n      </div>\n\n      {/* TARJETAS INDICADORAS DE RENDIMIENTO */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-6 gap-5\">\n        {/* CLIENTES ACTIVOS */}\n        <div className=\"bg-white border border-zinc-200 p-5 rounded-xl shadow-xs\" id=\"card-active-clients\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-zinc-500 text-xs font-medium uppercase tracking-wider font-sans\">Clientes Activos</span>\n            <span className=\"bg-emerald-50 text-emerald-700 p-1.5 rounded-lg text-xs font-semibold\">\n              <Users className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-3xl font-sans font-bold text-zinc-950\">{totalActivosCount}</h3>\n            <p className=\"text-zinc-400 text-xs mt-1\">Miembros registrados</p>\n          </div>\n        </div>\n\n        {/* % MOROSIDAD */}\n        <div className=\"bg-white border border-zinc-200 p-5 rounded-xl shadow-xs\" id=\"card-delinquency-rate\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-zinc-500 text-xs font-medium uppercase tracking-wider font-sans\">Mora Mensual</span>\n            <span className={`p-1.5 rounded-lg text-xs font-semibold ${porcentajeMorosidad > 15 ? \'bg-red-50 text-red-600\' : \'bg-amber-50 text-amber-600\'}`}>\n              <AlertTriangle className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-3xl font-sans font-bold text-zinc-950\">{porcentajeMorosidad}%</h3>\n            <p className=\"text-zinc-400 text-xs mt-1\">\n              <span className=\"font-semibold text-red-600\">{morososCount}</span> clientes impagos\n            </p>\n          </div>\n        </div>\n\n        {/* COBRANZA EFECTIVA */}\n        <div className=\"bg-white border border-zinc-200 p-5 rounded-xl shadow-xs\" id=\"card-collection-rate\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-zinc-500 text-xs font-medium uppercase tracking-wider font-sans\">% Cobranza</span>\n            <span className=\"bg-blue-50 text-blue-600 p-1.5 rounded-lg text-xs font-semibold\">\n              <TrendingUp className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-3xl font-sans font-bold text-zinc-950\">{porcentajeCobranza}%</h3>\n            <p className=\"text-zinc-400 text-xs mt-1\">Comportamiento de cobros</p>\n          </div>\n        </div>\n\n        {/* INGRESOS COBRADOS */}\n        <div className=\"bg-white border border-zinc-200 p-5 rounded-xl shadow-xs\" id=\"card-actual-income\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-zinc-500 text-xs font-medium uppercase tracking-wider font-sans\">Ingresos Reales</span>\n            <span className=\"bg-zinc-100 text-zinc-900 p-1.5 rounded-lg text-xs font-semibold\">\n              <DollarSign className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-2xl font-mono font-bold text-zinc-950\">\n              ${ingresosReales.toLocaleString(\'es-AR\')}\n            </h3>\n            <p className=\"text-zinc-400 text-xs mt-1\">ARS recolectado este mes</p>\n          </div>\n        </div>\n\n        {/* INGRESOS ESPERADOS */}\n        <div className=\"bg-white border border-zinc-200 p-5 rounded-xl shadow-xs\" id=\"card-theoretical-income\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-zinc-500 text-xs font-medium uppercase tracking-wider font-sans\">Ingreso Te\303\263rico</span>\n            <span className=\"bg-zinc-100 text-zinc-500 p-1.5 rounded-lg text-xs font-semibold\">\n              <DollarSign className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-2xl font-mono font-bold text-zinc-500\">\n              ${ingresosEsperados.toLocaleString(\'es-AR\')}\n            </h3>\n            <p className=\"text-zinc-400 text-xs mt-1\">Facturaci\303\263n proyectada al 100%</p>\n          </div>\n        </div>\n\n        {/* OCUPACI\303\223N PROMEDIO */}\n        <div className=\"bg-white border border-zinc-200 p-5 rounded-xl shadow-xs\" id=\"card-avg-occupancy\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-zinc-500 text-xs font-medium uppercase tracking-wider font-sans\">Ocupaci\303\263n</span>\n            <span className=\"bg-purple-50 text-purple-600 p-1.5 rounded-lg text-xs font-semibold\">\n              <Calendar className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-3xl font-sans font-bold text-zinc-950\">{ocupacionPromedio}%</h3>\n            <p className=\"text-zinc-400 text-xs mt-1\">Carga general de turnos</p>\n          </div>\n        </div>\n      </div>"
        replacement_content: "    <div className=\"space-y-8 p-6 max-w-7xl mx-auto\" id=\"dashboard-tab-panel\">\n      {/* SECCI\303\223N BIENVENIDA */}\n      <div className=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n        <div>\n          <h2 className=\"text-2xl font-sans font-bold tracking-tight text-slate-950\">Panel de Control General</h2>\n          <p className=\"text-slate-500 font-sans text-sm\">Resumen de indicativos y comportamiento operativo de los socios para el mes cursado</p>\n        </div>\n        \n        {/* BOTONERA ACCESOS RAPIDOS */}\n        <div className=\"flex flex-wrap gap-2\">\n          <button\n            onClick={() => {\n              if (setShowAddClienteModal) {\n                setShowAddClienteModal(true);\n              }\n              setActiveTab(\'CLIENTES\');\n            }}\n            className=\"bg-slate-900 hover:bg-slate-800 text-white px-3.5 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm cursor-pointer\"\n            id=\"quick-add-client-btn\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            Nuevo Socio\n          </button>\n          \n          <button\n            onClick={() => {\n              if (setShowAddPagoModal) {\n                setShowAddPagoModal(true);\n              }\n              setActiveTab(\'PAGOS\');\n            }}\n            className=\"bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 px-3.5 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm cursor-pointer\"\n            id=\"quick-add-payment-btn\"\n          >\n            <Receipt className=\"w-4 h-4 text-slate-500\" />\n            Registrar Pago\n          </button>\n          \n          <button\n            onClick={() => {\n              setActiveTab(\'TURNOS\');\n            }}\n            className=\"bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 px-3.5 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm cursor-pointer\"\n            id=\"quick-schedule-btn\"\n          >\n            <Grid className=\"w-4 h-4 text-slate-500\" />\n            Grilla Horarios\n          </button>\n        </div>\n      </div>\n\n      {/* TARJETAS INDICADORAS DE RENDIMIENTO */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-6 gap-5\">\n        {/* CLIENTES ACTIVOS */}\n        <div className=\"kpi-card-theme\" id=\"card-active-clients\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-slate-400 text-[10px] font-bold uppercase tracking-wider font-mono\">Clientes Activos</span>\n            <span className=\"bg-sky-50 text-sky-700 p-1.5 rounded-lg text-xs font-semibold border border-sky-100\">\n              <Users className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-3xl font-sans font-bold text-slate-900\">{totalActivosCount}</h3>\n            <p className=\"text-slate-400 text-[10px] mt-1 font-sans\">Socios registrados vigentes</p>\n          </div>\n        </div>\n\n        {/* % MOROSIDAD */}\n        <div className=\"kpi-card-theme\" id=\"card-delinquency-rate\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-slate-400 text-[10px] font-bold uppercase tracking-wider font-mono\">Morosidad Activa</span>\n            <span className={`p-1.5 rounded-lg text-xs font-semibold border ${porcentajeMorosidad > 15 ? \'bg-red-50 text-red-600 border-red-100\' : \'bg-amber-50 text-amber-655 border-amber-100\'}`}>\n              <AlertTriangle className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-3xl font-sans font-bold text-slate-900\">{porcentajeMorosidad}%</h3>\n            <p className=\"text-slate-400 text-[10px] mt-1 font-sans\">\n              <span className=\"font-semibold text-red-650\">{morososCount}</span> socios en mora\n            </p>\n          </div>\n        </div>\n\n        {/* COBRANZA EFECTIVA */}\n        <div className=\"kpi-card-theme\" id=\"card-collection-rate\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-slate-400 text-[10px] font-bold uppercase tracking-wider font-mono\">% Cobranzas</span>\n            <span className=\"bg-emerald-50 text-emerald-600 p-1.5 rounded-lg text-xs font-semibold border border-emerald-100\">\n              <TrendingUp className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-3xl font-sans font-bold text-slate-900\">{porcentajeCobranza}%</h3>\n            <p className=\"text-slate-400 text-[10px] mt-1 font-sans\">Ratio de cobro efectivo</p>\n          </div>\n        </div>\n\n        {/* INGRESOS COBRADOS */}\n        <div className=\"kpi-card-theme\" id=\"card-actual-income\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-slate-400 text-[10px] font-bold uppercase tracking-wider font-mono\">Ingresos Reales</span>\n            <span className=\"bg-slate-50 text-slate-700 p-1.5 rounded-lg text-xs font-semibold border border-slate-200\">\n              <DollarSign className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-2xl font-mono font-bold text-slate-900\">\n              ${ingresosReales.toLocaleString(\'es-AR\')}\n            </h3>\n            <p className=\"text-slate-400 text-[10px] mt-1 font-sans\">ARS recaudados este mes</p>\n          </div>\n        </div>\n\n        {/* INGRESOS ESPERADOS */}\n        <div className=\"kpi-card-theme\" id=\"card-theoretical-income\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-slate-400 text-[10px] font-bold uppercase tracking-wider font-mono\">Ingreso Te\303\263rico</span>\n            <span className=\"bg-slate-50 text-slate-400 p-1.5 rounded-lg text-xs font-semibold border border-slate-200/50\">\n              <DollarSign className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-2xl font-mono font-semibold text-slate-500\">\n              ${ingresosEsperados.toLocaleString(\'es-AR\')}\n            </h3>\n            <p className=\"text-slate-400 text-[10px] mt-1 font-sans\">Facturas al 100% de abono</p>\n          </div>\n        </div>\n\n        {/* OCUPACI\303\223N PROMEDIO */}\n        <div className=\"kpi-card-theme\" id=\"card-avg-occupancy\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-slate-400 text-[10px] font-bold uppercase tracking-wider font-mono\">Ocupaci\303\263n</span>\n            <span className=\"bg-violet-50 text-violet-600 p-1.5 rounded-lg text-xs font-semibold border border-violet-100\">\n              <Calendar className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-4\">\n            <h3 className=\"text-3xl font-sans font-bold text-slate-900\">{ocupacionPromedio}%</h3>\n            <p className=\"text-slate-400 text-[10px] mt-1 font-sans\">Carga de turnos e inscritos</p>\n          </div>\n        </div>\n      </div>"
