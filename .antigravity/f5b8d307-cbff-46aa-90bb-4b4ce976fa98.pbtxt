        replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", ui-sans-serif, system-ui, -apple-system, sRGB, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n}\n\n/* Custom styles matching Geometric Balance Design Theme */\nbody {\n  background-color: #f8fafc;\n  font-family: \'Inter\', system-ui, -apple-system, sans-serif;\n}\n\n.geometric-grid-layout {\n  display: grid;\n  grid-template-columns: 260px 1fr;\n  min-height: 100vh;\n}\n\n@media (max-width: 1024px) {\n  .geometric-grid-layout {\n    grid-template-columns: 1fr;\n  }\n}\n\n.kpi-card-theme {\n  background: #ffffff;\n  border: 1px solid #e2e8f0;\n  border-radius: 0.75rem;\n  padding: 1.25rem;\n  transition: all 0.2s ease;\n  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02);\n}\n\n.kpi-card-theme:hover {\n  border-color: #cbd5e1;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);\n  transform: translateY(-1px);\n}\n\n.custom-scrollbar::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n.custom-scrollbar::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.custom-scrollbar::-webkit-scrollbar-thumb {\n  background: #cbd5e1;\n  border-radius: 9999px;\n}\n\n.custom-scrollbar::-webkit-scrollbar-thumb:hover {\n  background: #94a3b8;\n}\n"
      }
      num_matches: 1
    }
  }
}
